p .shape{fill:#0c1416;stroke:var(--ink-dim,#9a9890)}.plate-svg .shape-check .shape,.plate-svg .shape-gate .shape{fill:#0c1416;stroke:#e8f6f1}.plate-svg .shape-commit .shape{fill:color-mix(in srgb, var(--canopy) 35%, #04110f);stroke:var(--canopy)}.plate-svg .label{font-size:2.3px;fill:#e8f6f1}.plate-svg .harness{font-size:1.9px;fill:var(--nc, var(--canopy));opacity:.9}.plate-svg .group-box{fill:none;stroke:var(--canopy,#00a9a0);stroke-width:.3;stroke-dasharray:1.2 .9;opacity:.8}.plate-svg .group-title,.plate-svg .group-subtitle{font-size:1.9px;fill:var(--canopy,#00a9a0);letter-spacing:.14em;text-transform:uppercase}.plate-svg .member-shape{fill:color-mix(in srgb, var(--nc, var(--canopy)) 22%, #04110f);stroke:var(--nc, var(--canopy));stroke-width:.3}.plate-svg .member-label{font-size:1.9px;fill:#e8f6f1;text-anchor:middle}.plate-svg .token{fill:var(--canopy,#00a9a0)}@media (prefers-reduced-motion:reduce){.plate-svg .token{display:none}}</style><g class="edges"><path class="edge error" d="M24.2 13 C24.2 74.5 24 74.5 24 136" data-from="implementer" data-to="tests"/><path class="edge order" d="M32.18 95.5 C32.18 99 32.18 99 32.18 102.5" data-from="reviewers" data-to="reviewers"/><path class="edge pass" d="M23.7 67 C23.7 75 32.18 75 32.18 83" data-from="gate" data-to="reviewers"/><path class="edge pass" d="M24.2 13 C24.2 24 23.7 24 23.7 35" data-from="implementer" data-to="triage"/><path class="edge pass" d="M32.18 110 C32.18 123 24 123 24 136" data-from="reviewers" data-to="tests"/><path class="edge pass" d="M24 136 C24 101.5 23.7 101.5 23.7 67" data-from="tests" data-to="gate"/><path class="edge pass" d="M23.7 35 C23.7 24 24.2 24 24.2 13" data-from="triage" data-to="implementer"/><path class="edge pass" d="M23.7 35 C23.7 85.5 24 85.5 24 136" data-from="triage" data-to="tests"/><path class="edge fail" d="M21 136 C10 136 10 13 21.2 13" data-from="tests" data-to="implementer"/></g><g class="groups"><g class="ensemble" data-name="reviewers"><rect class="group-box" x="21.2" y="83" width="21.96" height="27" rx="2"/><text class="group-title" x="23.2" y="86.4">REVIEWERS</text><text class="group-subtitle" x="23.2" y="88.8">PARALLEL · 1/2</text><g class="member" data-name="reviewers" data-i="1" data-cx="32.18" data-cy="95.5"><rect class="member-shape" x="25.18" y="93.5" width="14" height="4" rx="1"/><text class="member-label" x="32.18" y="95.5" dy="0.7">1</text></g><g class="member" data-name="reviewers" data-i="2" data-cx="32.18" data-cy="102.5"><rect class="member-shape" x="25.18" y="100.5" width="14" height="4" rx="1"/><text class="member-label" x="32.18" y="102.5" dy="0.7">2</text></g></g></g><g class="nodes"><g class="node shape-agent" data-name="implementer" data-cx="24.2" data-cy="13" data-w="6" data-h="6" data-rank="0" data-lane="main"><title>implementer (agent)</title><rect class="shape" x="21.2" y="10" width="6" height="6" rx="3"/><text class="label" x="29.2" y="13" dy="0.8" text-anchor="start">implementer</text></g><g class="node shape-gate" data-name="triage" data-cx="23.7" data-cy="35" data-w="5" data-h="5" data-rank="1" data-lane="main"><title>triage (router)</title><rect class="shape" x="21.2" y="32.5" width="5" height="5" rx="0.5" transform="rotate(45 23.7 35)"/><text class="label" x="28.2" y="35" dy="0.8" text-anchor="start">triage</text></g><g class="node shape-gate" data-name="gate" data-cx="23.7" data-cy="67" data-w="5" data-h="5" data-rank="3" data-lane="main"><title>gate (gate)</title><rect class="shape" x="21.2" y="64.5" width="5" height="5" rx="0.5" transform="rotate(45 23.7 67)"/><text class="label" x="28.2" y="67" dy="0.8" text-anchor="start">gate</text></g><g class="node shape-check" data-name="tests" data-cx="24" data-cy="136" data-w="5.6" data-h="5.6" data-rank="2" data-lane="infra"><title>tests (check)</title><rect class="shape" x="21.2" y="133.2" width="5.6" height="5.6" rx="0.7"/><text class="label" x="28.8" y="136" dy="0.8" text-anchor="start">tests</text></g></g><circle class="token" r="1.1" cx="0" cy="0"><animateMotion dur="3.6s" repeatCount="indefinite" path="M24.2 13C24.2 24 23.7 24 23.7 35C23.7 85.5 24 85.5 24 136C24 101.5 23.7 101.5 23.7 67C23.7 81.75 32.18 81.75 32.18 96.5"/></circle></svg></figure>
<dl class="sheet"><div class="field"><dt>Kind</dt><dd>graph</dd></div><div class="field"><dt>Name</dt><dd>hello-graph</dd></div><div class="field"><dt>Source</dt><dd><a href="https://github.com/acme/things">acme/things</a></dd></div><div class="field"><dt>Ref</dt><dd>main</dd></div><div class="field"><dt>Stars</dt><dd>2 stars</dd></div><div class="field"><dt>Nodes</dt><dd>agent 1 · router 1 · check 1 · gate 1</dd></div><div class="field"><dt>Edges</dt><dd>8 edges · 1 fail</dd></div><div class="field"><dt>Ensembles</dt><dd>reviewers (parallel, 2 members)</dd></div><div class="field"><dt>Agent nodes</dt><dd>implementer</dd></div><div class="field"><dt>Install</dt><dd><span class="row-install"><code>canopy graph install acme/things/flow</code><button type="button" class="copy" data-copy="canopy graph install acme/things/flow" aria-label="Copy the install command to the clipboard">Copy</button></span></dd></div></dl>
</div>

</main>
<footer class="look-colophon">
