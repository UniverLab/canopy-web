(function(){var stored=null;try{stored=localStorage.getItem("theme")}catch(e){}var hour=new Date().getHours();var theme=stored||(hour>=6&&hour<18?"day":"night");document.documentElement.dataset.theme=theme;document.addEventListener("DOMContentLoaded",function(){var button=document.getElementById("theme-toggle");if(!button){return}button.addEventListener("click",function(){var next=document.documentElement.dataset.theme==="day"?"night":"day";document.documentElement.dataset.theme=next;try{localStorage.setItem("theme",next)}catch(e){}});});})();
</script>
</head>
<body>
<header class="site-header">
<a class="brand" href="/">graphs.univerlab.org</a>
<button type="button" class="theme-toggle" id="theme-toggle" aria-label="Switch between day and night">Switch between day and night</button>
</header>
<p class="tagline">A catalogue of Canopy graphs and nodes.</p>
<main>
<h1>hello-graph</h1>
<p class="description">Minimal example graph: implement, check, gate, and a router with two routes.</p>
<p class="meta"><a href="https://github.com/acme/things">acme/things</a></p>
<p><a class="button" href="https://github.com/acme/things">Star on GitHub</a></p>
<h2>Install</h2>
<div class="install"><code>canopy graph install acme/things/flow</code><button type="button" class="copy" data-copy="canopy graph install acme/things/flow" aria-label="Copy the install command to the clipboard">Copy</button></div>
<h2>Drawing</h2><figure class="plate"><svg class="plate-svg" viewBox="0 0 142.57 74.55" width="713" height="373" role="img" xmlns="http://www.w3.org/2000/svg"><title>hello-graph</title><desc>Nodes in order: implementer, triage, tests, gate. Ensembles: reviewers.</desc><style>.plate-svg text{font-family:var(--font-mono,"Sometype Mono","Courier New",monospace)}.plate-svg .edge{fill:none;stroke:var(--canopy,#00a9a0);stroke-width:.45;opacity:.85}.plate-svg .edge.fail{stroke:#ff6b6b;stroke-dasharray:1.4 1.1;opacity:.7}.plate-svg .edge.error{stroke:currentColor;stroke-width:.3;stroke-dasharray:.4 .8;opacity:.45}.plate-svg .edge.order{stroke:currentColor;stroke-width:.3;stroke-dasharray:.5 1.1;stroke-linecap:round;opacity:.9}.plate-svg .node .shape{fill:var(--bg,#fff);stroke:currentColor;stroke-width:.45}.plate-svg .shape-agent .shape{stroke:var(--canopy,#00a9a0)}.plate-svg .shape-commit .shape{fill:var(--canopy,#00a9a0);stroke:var(--canopy,#00a9a0)}.plate-svg .label{font-size:2.3px;fill:currentColor;text-anchor:middle}.plate-svg .group-box{fill:none;stroke:var(--canopy,#00a9a0);stroke-width:.3;stroke-dasharray:1.2 .9;opacity:.8}.plate-svg .group-title,.plate-svg .group-subtitle{font-size:1.9px;fill:var(--canopy,#00a9a0);letter-spacing:.14em;text-transform:uppercase}.plate-svg .member-shape{fill:var(--bg,#fff);stroke:currentColor;stroke-width:.3}.plate-svg .member-label{font-size:1.9px;fill:currentColor;text-anchor:middle}.plate-svg .token{fill:var(--canopy,#00a9a0)}@media (prefers-reduced-motion:reduce){.plate-svg .token{display:none}}</style><g class="edges"><path class="edge error" d="M17.59 18 C43.59 18 43.59 57 69.59 57" data-from="implementer" data-to="tests"/><path class="edge order" d="M121.59 22.5 C121.59 22.5 121.59 29.5 121.59 29.5" data-from="reviewers" data-to="reviewers"/><path class="edge pass" d="M95.59 18 C103.1 18 103.1 23.5 110.61 23.5" data-from="gate" data-to="reviewers"/><path class="edge pass" d="M17.59 18 C30.59 18 30.59 18 43.59 18" data-from="implementer" data-to="triage"/><path class="edge pass" d="M132.57 23.5 C101.08 23.5 101.08 57 69.59 57" data-from="reviewers" data-to="tests"/><path class="edge pass" d="M69.59 57 C82.59 57 82.59 18 95.59 18" data-from="tests" data-to="gate"/><path class="edge pass" d="M43.59 18 C30.59 18 30.59 18 17.59 18" data-from="triage" data-to="implementer"/><path class="edge pass" d="M43.59 18 C56.59 18 56.59 57 69.59 57" data-from="triage" data-to="tests"/><path class="edge fail" d="M69.59 57 C43.59 57 43.59 18 17.59 18" data-from="tests" data-to="implementer"/></g><g class="groups"><g class="ensemble" data-name="reviewers"><rect class="group-box" x="110.61" y="10" width="21.96" height="27" rx="2"/><text class="group-title" x="112.61" y="13.4">REVIEWERS</text><text class="group-subtitle" x="112.61" y="15.8">PARALLEL · 1/2</text><g class="member" data-name="reviewers" data-i="1" data-cx="121.59" data-cy="22.5"><rect class="member-shape" x="114.59" y="20.5" width="14" height="4" rx="1"/><text class="member-label" x="121.59" y="22.5" dy="0.7">1</text></g><g class="member" data-name="reviewers" data-i="2" data-cx="121.59" data-cy="29.5"><rect class="member-shape" x="114.59" y="27.5" width="14" height="4" rx="1"/><text class="member-label" x="121.59" y="29.5" dy="0.7">2</text></g></g></g><g class="nodes"><g class="node shape-agent" data-name="implementer" data-cx="17.59" data-cy="18" data-w="6" data-h="6" data-rank="0" data-lane="main"><title>implementer (agent)</title><rect class="shape" x="14.59" y="15" width="6" height="6" rx="3"/><text class="label" x="17.59" y="18" dy="6.4">implementer</text></g><g class="node shape-gate" data-name="triage" data-cx="43.59" data-cy="18" data-w="5" data-h="5" data-rank="1" data-lane="main"><title>triage (router)</title><rect class="shape" x="41.09" y="15.5" width="5" height="5" rx="0.5" transform="rotate(45 43.59 18)"/><text class="label" x="43.59" y="18" dy="6.4">triage</text></g><g class="node shape-gate" data-name="gate" data-cx="95.59" data-cy="18" data-w="5" data-h="5" data-rank="3" data-lane="main"><title>gate (gate)</title><rect class="shape" x="93.09" y="15.5" width="5" height="5" rx="0.5" transform="rotate(45 95.59 18)"/><text class="label" x="95.59" y="18" dy="6.4">gate</text></g><g class="node shape-check" data-name="tests" data-cx="69.59" data-cy="57" data-w="5.6" data-h="5.6" data-rank="2" data-lane="infra"><title>tests (check)</title><rect class="shape" x="66.79" y="54.2" width="5.6" height="5.6" rx="0.7"/><text class="label" x="69.59" y="57" dy="6.4">tests</text></g></g><circle class="token" r="1.1" cx="17.59" cy="18"><animateMotion dur="3.6s" repeatCount="indefinite" path="M17.59 18C30.59 18 30.59 18 43.59 18C56.59 18 56.59 57 69.59 57C82.59 57 82.59 18 95.59 18C108.59 18 108.59 23.5 121.59 23.5"/></circle></svg></figure>
<h2>Agent nodes</h2><p class="agent-nodes">implementer</p><p>These agent nodes need a harness to run.</p>
<h2>README</h2>
<div class="readme"></div>
</main>
<footer class="site-footer"><a href="https://univerlab.org/canopy/">Canopy · UniverLab</a></footer>
<script>
(function(){document.addEventListener("click",function(event){var target=event.target;if(!target||!target.classList||!target.classList.contains("copy")){return}var command=target.getAttribute("data-copy")||"";if(navigator.clipboard){navigator.clipboard.writeText(command)}var original=target.textContent;target.textContent=command;window.setTimeout(function(){target.textContent=original},1500);});})();
</script>
</body>
</html>
"
`;

