  grid-template-columns: 7.5rem minmax(0, 1fr);
  gap: 0.75rem;
  padding: 0.5rem 0;
  border-bottom: 1px solid var(--surface-line);
}
.sheet .field:first-child { border-top: 1px solid var(--surface-line); }
.sheet dt {
  margin: 0;
  font-size: 0.72rem;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--surface-ink-dim);
}
.sheet dd { margin: 0; min-width: 0; overflow-wrap: anywhere; }
.sheet .row-install { margin-left: 0; width: 100%; }
.sheet .row-install code { flex: 1; min-width: 0; }

figure.plate {
  margin: 0 0 1.5rem;
  padding: 0.75rem;
  max-width: 100%;
  overflow-x: auto;
  background: var(--bg-deep);
  border: 1px solid var(--surface-line);
  border-radius: var(--radius-card);
}
.doc-cols figure.plate { margin: 0; }
.plate svg { display: block; height: auto; margin: 0 auto; }
.plate .plate-v { display: none; }

.readme { font-family: var(--font-body); font-size: 1.05rem; line-height: 1.6; }
.readme h1, .readme h2, .readme h3 {
  font-family: var(--font-body);
  font-weight: 500;
  text-transform: none;
  letter-spacing: 0;
  color: var(--ink-hi);
}
.readme h1 { font-size: 1.6rem; }
.readme h2 { font-size: 1.3rem; }
.readme h3 { font-size: 1.1rem; }
.readme pre {
  padding: 0.75rem;
  background: var(--bg-deep);
  border: 1px solid var(--surface-line);
  border-radius: var(--radius-ctl);
  font-family: var(--font-mono);
  font-size: 0.82rem;
  overflow-x: auto;
}
.readme code { font-family: var(--font-mono); font-size: 0.9em; }
.readme img { max-width: 100%; height: auto; }
.busy { padding: 0.25rem 0 0.25rem 1rem; border-left: 3px solid var(--teal); }

@media (max-width: 639px) {
  .plate .plate-h { display: none; }
  .plate .plate-v { display: block; }
}
@media (max-width: 899px) {
  .row-desc { order: 1; }
  .row-install { order: 2; flex-basis: 100%; margin-left: 0; }
  .row-install code { flex: 1; }
}
@media (min-width: 640px) {
  .site-header { height: 160px; }
  .band { padding: 0 1.5rem; }
  main.look-col { padding: 2rem 1.5rem 4rem; }
}
@media (min-width: 1024px) {
  .doc-cols { flex-direction: row; align-items: flex-start; }
  .doc-cols figure.plate { flex: 1; min-width: 0; }
  dl.sheet { flex: 0 0 320px; }
}
@media (prefers-reduced-motion: reduce) {
  * { transition: none !important; animation: none !important; }
}
</style>
</head>
<body>
<div class="look-shell">
<header class="site-header">
<div class="fondo" id="fondo" aria-hidden="true"></div>
<div class="band">
<div class="band-top">
<a class="wordmark" href="https://univerlab.org/canopy/">graphs</a>
<nav class="site-nav" aria-label="Catalogue">
<a href="/publish">Publish</a>
<a href="https://github.com/UniverLab/canopy-web">Source</a>
</nav>
</div>
<form class="search" action="/search" method="get" role="search"><label class="sr-only" for="q">Search graphs and nodes</label><input id="q" name="q" type="search" value="" placeholder="hello-graph" autocomplete="off"><button type="submit">Search</button></form>
</div>
</header>
<main class="look-col">
<h1 class="doc-title">hello-graph</h1>
<p class="description">Minimal example graph: implement, check, gate, and a router with two routes.</p>
<p><a class="button" href="https://github.com/acme/things">Star on GitHub</a></p>
<div class="doc-cols">
<figure class="plate"><svg class="plate-svg plate-h" viewBox="0 0 142.57 74.55" width="713" height="373" role="img" xmlns="http://www.w3.org/2000/svg"><title>hello-graph</title><desc>Nodes in order: implementer, triage, tests, gate. Ensembles: reviewers.</desc><style>.plate-svg text{font-family:var(--font-mono,"Sometype Mono","Courier New",monospace)}.plate-svg .edge{fill:none;stroke:var(--canopy,#00a9a0);stroke-width:.45;opacity:.85}.plate-svg .edge.fail{stroke:#ff6b6b;stroke-dasharray:1.4 1.1;opacity:.7}.plate-svg .edge.error{stroke:currentColor;stroke-width:.3;stroke-dasharray:.4 .8;opacity:.45}.plate-svg .edge.order{stroke:currentColor;stroke-width:.3;stroke-dasharray:.5 1.1;stroke-linecap:round;opacity:.9}.plate-svg .node .shape{fill:color-mix(in srgb, var(--nc, var(--canopy)) 22%, #04110f);stroke:var(--nc, var(--canopy));stroke-width:.45}.plate-svg .shape-chip .shape{fill:#0c1416;stroke:var(--ink-dim,#9a9890)}.plate-svg .shape-check .shape,.plate-svg .shape-gate .shape{fill:#0c1416;stroke:#e8f6f1}.plate-svg .shape-commit .shape{fill:color-mix(in srgb, var(--canopy) 35%, #04110f);stroke:var(--canopy)}.plate-svg .label{font-size:2.3px;fill:#e8f6f1}.plate-svg .harness{font-size:1.9px;fill:var(--nc, var(--canopy));opacity:.9}.plate-svg .group-box{fill:none;stroke:var(--canopy,#00a9a0);stroke-width:.3;stroke-dasharray:1.2 .9;opacity:.8}.plate-svg .group-title,.plate-svg .group-subtitle{font-size:1.9px;fill:var(--canopy,#00a9a0);letter-spacing:.14em;text-transform:uppercase}.plate-svg .member-shape{fill:color-mix(in srgb, var(--nc, var(--canopy)) 22%, #04110f);stroke:var(--nc, var(--canopy));stroke-width:.3}.plate-svg .member-label{font-size:1.9px;fill:#e8f6f1;text-anchor:middle}.plate-svg .token{fill:var(--canopy,#00a9a0)}@media (prefers-reduced-motion:reduce){.plate-svg .token{display:none}}</style><g class="edges"><path class="edge error" d="M17.59 18 C43.59 18 43.59 57 69.59 57" data-from="implementer" data-to="tests"/><path class="edge order" d="M121.59 22.5 C121.59 22.5 121.59 29.5 121.59 29.5" data-from="reviewers" data-to="reviewers"/><path class="edge pass" d="M95.59 18 C103.1 18 103.1 23.5 110.61 23.5" data-from="gate" data-to="reviewers"/><path class="edge pass" d="M17.59 18 C30.59 18 30.59 18 43.59 18" data-from="implementer" data-to="triage"/><path class="edge pass" d="M132.57 23.5 C101.08 23.5 101.08 57 69.59 57" data-from="reviewers" data-to="tests"/><path class="edge pass" d="M69.59 57 C82.59 57 82.59 18 95.59 18" data-from="tests" data-to="gate"/><path class="edge pass" d="M43.59 18 C30.59 18 30.59 18 17.59 18" data-from="triage" data-to="implementer"/><path class="edge pass" d="M43.59 18 C56.59 18 56.59 57 69.59 57" data-from="triage" data-to="tests"/><path class="edge fail" d="M69.59 57 C43.59 57 43.59 18 17.59 18" data-from="tests" data-to="implementer"/></g><g class="groups"><g class="ensemble" data-name="reviewers"><rect class="group-box" x="110.61" y="10" width="21.96" height="27" rx="2"/><text class="group-title" x="112.61" y="13.4">REVIEWERS</text><text class="group-subtitle" x="112.61" y="15.8">PARALLEL · 1/2</text><g class="member" data-name="reviewers" data-i="1" data-cx="121.59" data-cy="22.5"><rect class="member-shape" x="114.59" y="20.5" width="14" height="4" rx="1"/><text class="member-label" x="121.59" y="22.5" dy="0.7">1</text></g><g class="member" data-name="reviewers" data-i="2" data-cx="121.59" data-cy="29.5"><rect class="member-shape" x="114.59" y="27.5" width="14" height="4" rx="1"/><text class="member-label" x="121.59" y="29.5" dy="0.7">2</text></g></g></g><g class="nodes"><g class="node shape-agent" data-name="implementer" data-cx="17.59" data-cy="18" data-w="6" data-h="6" data-rank="0" data-lane="main"><title>implementer (agent)</title><rect class="shape" x="14.59" y="15" width="6" height="6" rx="3"/><text class="label" x="17.59" y="18" dy="6.4" text-anchor="middle">implementer</text></g><g class="node shape-gate" data-name="triage" data-cx="43.59" data-cy="18" data-w="5" data-h="5" da