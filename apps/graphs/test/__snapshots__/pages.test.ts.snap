ta-w="6" data-h="6" data-rank="4" data-lane="main"><title>docs (agent)</title><rect class="shape" x="17.4" y="98" width="6" height="6" rx="3"/><text class="label" x="25.4" y="101" dy="0.8" text-anchor="start">docs</text></g></g><circle class="token" r="1.1" cx="0" cy="0"><animateMotion dur="3.6s" repeatCount="indefinite" path="M20.4 13C20.4 24 20.2 24 20.2 35C20.2 46 19.9 46 19.9 57C19.9 68 19.9 68 19.9 79C19.9 90 20.4 90 20.4 101"/></circle></svg></figure>
