exports[`route snapshots > renders /llms.txt with one line per document 1`] = `
"# graphs.univerlab.org — the Canopy graph and node catalogue.

hello-graph	Five nodes with one fail edge, for the drawing test.	hello-graph
hello-node	Example catalogue node: drafts an implementation plan.	hello-node
"
`;

exports[`route snapshots > renders /n/<slug> with the one node 1`] = `
"<!doctype html>
<html lang="en" data-surface="tui">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>hello-node · graphs.univerlab.org</title>
<meta name="description" content="Example catalogue node: drafts an implementation plan.">
<link rel="stylesheet" href="/look/tokens.css">
<link rel="stylesheet" href="/look/fonts/fonts.css">
<link rel="stylesheet" href="/look/colophon/colophon.css">
<style>
*, *::before, *::after { box-sizing: border-box; }
html {
  background: var(--surface-bg);
  color-scheme: dark;
}
body {
  margin: 0;
  min-height: 100vh;
  background: var(--surface-bg);
  color: var(--surface-ink);
  font-family: var(--font-mono);
  font-size: 0.9375rem;
  line-height: 1.55;
  -webkit-text-size-adjust: 100%;
}
a { color: var(--teal); text-underline-offset: 0.15em; }
a:hover { text-decoration-thickness: 2px; }
:focus-visible { outline: 2px solid var(--teal); outline-offset: 3px; }
.look-shell { min-height: 100vh; }

.site-header {
  position: relative;
  height: 120px;
  overflow: hidden;
  border-bottom: 1px solid var(--surface-line);
}
.fondo { position: absolute; inset: 0; z-index: 0; pointer-events: none; }
.band {
  position: relative;
  z-index: 1;
  max-width: 1120px;
  height: 100%;
  margin: 0 auto;
  padding: 0 1rem;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 0.6rem;
}
.band-top {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 1rem;
}
.wordmark {
  display: inline-block;
  padding-bottom: 0.15rem;
  border-bottom: 1px solid var(--surface-line);
  font-family: var(--font-mono);
  font-size: 1rem;
  letter-spacing: 0.08em;
  color: var(--surface-ink);
  text-decoration: none;
}
.wordmark:hover { border-bottom-color: var(--teal); }
.site-nav {
  display: flex;
  gap: 1rem;
  font-family: var(--font-mono);
  font-size: 0.82rem;
}
.site-nav a { color: var(--surface-ink-dim); text-decoration: none; }
.site-nav a:hover { color: var(--surface-ink); text-decoration: underline; text-decoration-color: var(--teal); }

.search { display: flex; gap: 0.5rem; margin: 0; }
.sr-only {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0 0 0 0);
  white-space: nowrap;
  border: 0;
}
.search input {
  flex: 1;
  min-width: 0;
  padding: 0.55rem 0.7rem;
  background: var(--bg-deep);
  color: var(--surface-ink);
  border: 1px solid var(--surface-line);
  border-radius: var(--radius-ctl);
  font-family: var(--font-mono);
  font-size: 0.9rem;
}
.search button {
  flex: none;
  padding: 0.55rem 1rem;
  background: transparent;
  border: 1px solid var(--surface-line);
  border-radius: var(--radius-ctl);
  color: var(--surface-ink);
  font-family: var(--font-mono);
  font-size: 0.85rem;
  cursor: pointer;
}
.search button:hover { border-color: var(--teal); }

main.look-col { max-width: 1120px; margin: 0 auto; padding: 1.5rem 1rem 3.5rem; }

h1, h2, h3 { font-weight: 400; line-height: 1.25; color: var(--ink-hi); }
h1 { margin: 0 0 1rem; font-family: var(--font-mono); font-size: 1.05rem; }
.index-title { font-family: var(--font-mono); font-size: 1.05rem; margin: 0 0 1rem; }
.doc-title { font-family: var(--font-display); font-size: clamp(1.7rem, 5vw, 2.3rem); margin: 0 0 0.5rem; }
.kicker {
  margin: 0;
  font-family: var(--font-mono);
  font-size: 0.78rem;
  font-weight: 500;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--surface-ink-dim);
}
h2.kicker { margin: 2rem 0 0.75rem; }
h3.kicker { margin: 1.25rem 0 0.5rem; }
p { margin: 0 0 1rem; }
.description { margin: 0 0 1rem; font-family: var(--font-body); font-size: 1.1rem; color: var(--surface-ink-dim); }

.tabs {
  display: flex;
  flex-wrap: wrap;
  gap: 0.9rem;
  margin: 0 0 1.5rem;
  font-family: var(--font-mono);
  font-size: 0.78rem;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}
.tabs a {
  padding-bottom: 0.15rem;
  border-bottom: 1px solid transparent;
  color: var(--surface-ink-dim);
  text-decoration: none;
}
.tabs a[aria-current="page"] { border-bottom-color: var(--teal); color: var(--surface-ink); }

ol.index {
  list-style: none;
  margin: 0 0 1.5rem;
  padding: 0;
  border-top: 1px solid var(--surface-line);
}
li.row {
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
  gap: 0.35rem 0.75rem;
  padding: 0.7rem 0;
  border-bottom: 1px solid var(--surface-line);
  font-family: var(--font-mono);
  font-size: 0.85rem;
}
.row-name {
  font-family: var(--font-display);
  font-size: 1.15rem;
  color: var(--surface-ink);
  text-decoration: none;
}
.row-name:hover { text-decoration: underline; text-decoration-color: var(--teal); }
.kind {
  padding: 0.05rem 0.4rem;
  border: 1px solid var(--surface-line);
  border-radius: var(--radius-ctl);
  font-size: 0.72rem;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  color: var(--surface-ink-dim);
}
.row-meta { color: var(--surface-ink-dim); white-space: nowrap; }
.dots { display: inline-flex; gap: 0.3rem; align-self: center; }
.dot {
  display: inline-block;
  width: 0.55rem;
  height: 0.55rem;
  border-radius: 50%;
  background: var(--nc, var(--canopy));
}
.row-install { display: inline-flex; gap: 0.5rem; align-items: center; margin-left: auto; min-width: 0; }
.row-install code {
  padding: 0.35rem 0.6rem;
  background: var(--bg-deep);
  border: 1px solid var(--surface-line);
  border-radius: var(--radius-ctl);
  color: var(--surface-ink);
  font-family: var(--font-mono);
  font-size: 0.78rem;
  line-height: 1.5;
  white-space: nowrap;
  overflow-x: auto;
}
.row-desc {
  flex-basis: 100%;
  font-family: var(--font-body);
  font-size: 1rem;
  color: var(--surface-ink-dim);
}

.button {
  display: inline-block;
  padding: 0.6rem 1.1rem;
  border: 0;
  border-radius: var(--radius-ctl);
  background: var(--cta-gradient);
  color: #012624;
  font-family: var(--font-mono);
  font-size: 0.85rem;
  letter-spacing: 0.04em;
  text-decoration: none;
  cursor: pointer;
}
.button:hover { filter: brightness(1.05); }
.copy {
  flex: none;
  padding: 0.35rem 0.7rem;
  background: transparent;
  border: 1px solid var(--surface-line);
  border-radius: var(--radius-ctl);
  color: var(--surface-ink);
  font-family: var(--font-mono);
  font-size: 0.78rem;
  cursor: pointer;
}
.copy:hover { border-color: var(--teal); }

.doc-cols { display: flex; flex-direction: column; gap: 1.5rem; margin: 1rem 0 1.5rem; }
dl.sheet { margin: 0; font-family: var(--font-mono); font-size: 0.85rem; }
.sheet .field {
  display: grid;
  grid-template-columns: 7.5rem minmax(0, 1fr);
  gap: 0.75rem;
  padding: 0.5rem 0;
  border-bottom: 1px solid var(--surface-line);
}
.sheet .field:first-child { border-top: 1px solid var(--surface-line); }
.sheet dt {
  margin: 0;
  font-size: 0.72rem;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--surface-ink-dim);
}
.sheet dd { margin: 0; min-width: 0; overflow-wrap: anywhere; }
.sheet .row-install { margin-left: 0; width: 100%; }
.sheet .row-install code { flex: 1; min-width: 0; }

figure.plate {
  margin: 0 0 1.5rem;
  padding: 0.75rem;
  max-width: 100%;
  overflow-x: auto;
  background: var(--bg-deep);
  border: 1px solid var(--surface-line);
  border-radius: var(--radius-card);
}
.doc-cols figure.plate { margin: 0; }
.plate svg { display: block; height: auto; margin: 0 auto; }
.plate .plate-v { display: none; }

.readme { font-family: var(--font-body); font-size: 1.05rem; line-height: 1.6; }
.readme h1, .readme h2, .readme h3 {
  font-family: var(--font-body);
  font-weight: 500;
  text-transform: none;
  letter-spacing: 0;
  color: var(--ink-hi);
}
.readme h1 { font-size: 1.6rem; }
.readme h2 { font-size: 1.3rem; }
.readme h3 { font-size: 1.1rem; }
.readme pre {
  padding: 0.75rem;
  background: var(--bg-deep);
  border: 1px solid var(--surface-line);
  border-radius: var(--radius-ctl);
  font-family: var(--font-mono);
  font-size: 0.82rem;
  overflow-x: auto;
}
.readme code { font-family: var(--font-mono); font-size: 0.9em; }
.readme img { max-width: 100%; height: auto; }
.busy { padding: 0.25rem 0 0.25rem 1rem; border-left: 3px solid var(--teal); }

@media (max-width: 639px) {
  .plate .plate-h { display: none; }
  .plate .plate-v { display: block; }
}
@media (max-width: 899px) {
  .row-desc { order: 1; }
  .row-install { order: 2; flex-basis: 100%; margin-left: 0; }
  .row-install code { flex: 1; }
}
@media (min-width: 640px) {
  .site-header { height: 160px; }
  .band { padding: 0 1.5rem; }
  main.look-col { padding: 2rem 1.5rem 4rem; }
}
@media (min-width: 1024px) {
  .doc-cols { flex-direction: row; align-items: flex-start; }
  .doc-cols figure.plate { flex: 1; min-width: 0; }
  dl.sheet { flex: 0 0 320px; }
}
@media (prefers-reduced-motion: reduce) {
  * { transition: none !important; animation: none !important; }
}
</style>
</head>
<body>
<div class="look-shell">
<header class="site-header">
<div class="fondo" id="fondo" aria-hidden="true"></div>
<div class="band">
<div class="band-top">
<a class="wordmark" href="https://univerlab.org/canopy/">graphs</a>
<nav class="site-nav" aria-label="Catalogue">
<a href="/publish">Publish</a>
<a href="https://github.com/UniverLab/canopy-web">Source</a>
</nav>
</div>
<form class="search" action="/search" method="get" role="search"><label class="sr-only" for="q">Search graphs and nodes</label><input id="q" name="q" type="search" value="" placeholder="hello-graph" autocomplete="off"><button type="submit">Search</button></form>
</div>
</header>
<main class="look-col">
<h1 class="doc-title">hello-node</h1>
<p class="description">Example catalogue node: drafts an implementation plan.</p>
<p><a class="button" href="https://github.com/UniverLab/canopy-web">Star on GitHub</a></p>
<div class="doc-cols">
<figure class="plate"><svg class="plate-svg plate-h" viewBox="0 0 33.8 30.55" width="169" height="153" role="img" xmlns="http://www.w3.org/2000/svg"><title>hello-node</title><desc>Nodes in order: hello-node.</desc><style>.plate-svg text{font-family:var(--font-mono,"Sometype Mono","Courier New",monospace)}.plate-svg .edge{fill:none;stroke:var(--canopy,#00a9a0);stroke-width:.45;opacity:.85}.plate-svg .edge.fail{stroke:#ff6b6b;stroke-dasharray:1.4 1.1;opacity:.7}.plate-svg .edge.error{stroke:currentColor;stroke-width:.3;stroke-dasharray:.4 .8;opacity:.45}.plate-svg .edge.order{stroke:currentColor;stroke-width:.3;stroke-dasharray:.5 1.1;stroke-linecap:round;opacity:.9}.plate-svg .node .shape{fill:color-mix(in srgb, var(--nc, var(--canopy)) 22%, #04110f);stroke:var(--nc, var(--canopy));stroke-width:.45}.plate-svg .shape-chip .shape{fill:#0c1416;stroke:var(--ink-dim,#9a9890)}.plate-svg .shape-check .shape,.plate-svg .shape-gate .shape{fill:#0c1416;stroke:#e8f6f1}.plate-svg .shape-commit .shape{fill:color-mix(in srgb, var(--canopy) 35%, #04110f);stroke:var(--canopy)}.plate-svg .label{font-size:2.3px;fill:#e8f6f1}.plate-svg .harness{font-size:1.9px;fill:var(--nc, var(--canopy));opacity:.9}.plate-svg .group-box{fill:none;stroke:var(--canopy,#00a9a0);stroke-width:.3;stroke-dasharray:1.2 .9;opacity:.8}.plate-svg .group-title,.plate-svg .group-subtitle{font-size:1.9px;fill:var(--canopy,#00a9a0);letter-spacing:.14em;text-transform:uppercase}.plate-svg .member-shape{fill:color-mix(in srgb, var(--nc, var(--canopy)) 22%, #04110f);stroke:var(--nc, var(--canopy));stroke-width:.3}.plate-svg .member-label{font-size:1.9px;fill:#e8f6f1;text-anchor:middle}.plate-svg .token{fill:var(--canopy,#00a9a0)}@media (prefers-reduced-motion:reduce){.plate-svg .token{display:none}}</style><g class="edges"></g><g class="groups"></g><g class="nodes"><g class="node shape-agent" data-name="hello-node" data-cx="16.9" data-cy="13" data-w="6" data-h="6" data-rank="0" data-lane="main"><title>hello-node (agent)</title><rect class="shape" x="13.899999999999999" y="10" width="6" height="6" rx="3"/><text class="label" x="16.9" y="13" dy="6.4" text-anchor="middle">hello-node</text></g></g></svg><svg class="plate-svg plate-v" viewBox="0 0 41.8 26" width="209" height="130" role="img" xmlns="http://www.w3.org/2000/svg"><title>hello-node</title><desc>Nodes in order: hello-node.</desc><style>.plate-svg text{font-family:var(--font-mono,"Sometype Mono","Courier New",monospace)}.plate-svg .edge{fill:none;stroke:var(--canopy,#00a9a0);stroke-width:.45;opacity:.85}.plate-svg .edge.fail{stroke:#ff6b6b;stroke-dasharray:1.4 1.1;opacity:.7}.plate-svg .edge.error{stroke:currentColor;stroke-width:.3;stroke-dasharray:.4 .8;opacity:.45}.plate-svg .edge.order{stroke:currentColor;stroke-width:.3;stroke-dasharray:.5 1.1;stroke-linecap:round;opacity:.9}.plate-svg .node .shape{fill:color-mix(in srgb, var(--nc, var(--canopy)) 22%, #04110f);stroke:var(--nc, var(--canopy));stroke-width:.45}.plate-svg .shape-chip .shape{fill:#0c1416;stroke:var(--ink-dim,#9a9890)}.plate-svg .shape-check .shape,.plate-svg .shape-gate .shape{fill:#0c1416;stroke:#e8f6f1}.plate-svg .shape-commit .shape{fill:color-mix(in srgb, var(--canopy) 35%, #04110f);stroke:var(--canopy)}.plate-svg .label{font-size:2.3px;fill:#e8f6f1}.plate-svg .harness{font-size:1.9px;fill:var(--nc, var(--canopy));opacity:.9}.plate-svg .group-box{fill:none;stroke:var(--canopy,#00a9a0);stroke-width:.3;stroke-dasharray:1.2 .9;opacity:.8}.plate-svg .group-title,.plate-svg .group-subtitle{font-size:1.9px;fill:var(--canopy,#00a9a0);letter-spacing:.14em;text-transform:uppercase}.plate-svg .member-shape{fill:color-mix(in srgb, var(--nc, var(--canopy)) 22%, #04110f);stroke:var(--nc, var(--canopy));stroke-width:.3}.plate-svg .member-label{font-size:1.9px;fill:#e8f6f1;text-anchor:middle}.plate-svg .token{fill:var(--canopy,#00a9a0)}@media (prefers-reduced-motion:reduce){.plate-svg .token{display:none}}</style><g class="edges"></g><g class="groups"></g><g class="nodes"><g class="node shape-agent" data-name="hello-node" data-cx="13" data-cy="13" data-w="6" data-h="6" data-rank="0" data-lane="main"><title>hello-node (agent)</title><rect class="shape" x="10" y="10" width="6" height="6" rx="3"/><text class="label" x="18" y="13" dy="0.8" text-anchor="start">hello-node</text></g></g></svg></figure>
<dl class="sheet"><div class="field"><dt>Kind</dt><dd>node</dd></div><div class="field"><dt>Name</dt><dd>hello-node</dd></div><div class="field"><dt>Source</dt><dd><a href="https://github.com/UniverLab/canopy-web">UniverLab/canopy-web</a></dd></div><div class="field"><dt>Stars</dt><dd>7 stars</dd></div><div class="field"><dt>Install</dt><dd><span class="row-install"><code>canopy node install hello-node</code><button type="button" class="copy" data-copy="canopy node install hello-node" aria-label="Copy the install command to the clipboard">Copy</button></span></dd></div></dl>
</div>

</main>
<footer class="look-colophon">
  <picture class="colophon-band" aria-hidden="true">
    <source type="image/avif" srcset="/look/colophon/frieze-960.avif 960w, /look/colophon/frieze-1920.avif 1920w" sizes="100vw">
    <img src="/look/colophon/frieze-1920.webp" srcset="/look/colophon/frieze-960.webp 960w, /look/colophon/frieze-1920.webp 1920w" sizes="100vw" width="1920" height="608" alt="" loading="lazy" decoding="async">
  </picture>
  <div class="colophon-content">
