exports[`route snapshots > renders /g/<slug> with the drawing and the install command 1`] = `
"<!doctype html>
<html lang="en" data-surface="tui">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>hello-graph · graphs.univerlab.org</title>
<meta name="description" content="Five nodes with one fail edge, for the drawing test.">
<link rel="stylesheet" href="/look/tokens.css">
<link rel="stylesheet" href="/look/fonts/fonts.css">
<link rel="stylesheet" href="/look/colophon/colophon.css">
<link rel="stylesheet" href="/look/banner/banner.css">
<style>
*, *::before, *::after { box-sizing: border-box; }
html {
  background: var(--surface-bg);
  color-scheme: dark;
}
body {
  margin: 0;
  min-height: 100vh;
  background: var(--surface-bg);
  color: var(--surface-ink);
  font-family: var(--font-mono);
  font-size: 0.9375rem;
  line-height: 1.55;
  -webkit-text-size-adjust: 100%;
}
a { color: var(--teal); text-underline-offset: 0.15em; }
a:hover { text-decoration-thickness: 2px; }
:focus-visible { outline: 2px solid var(--teal); outline-offset: 3px; }

/* Every icon is Lucide data drawn inline (packages/look/icon-svg.ts): one
 * box, currentColor, no font and no request. The slot keeps the box fixed
 * while its path morphs (the Copy button). */
.icon { display: inline-block; width: 16px; height: 16px; flex: none; vertical-align: -0.15em; }
.icon-slot { display: inline-flex; align-items: center; justify-content: center; width: 16px; height: 16px; flex: none; }
.icon-slot svg, .icon-slot morph-icon { display: block; }
.copy, .search button, .site-nav a, .button { display: inline-flex; align-items: center; gap: 0.4rem; }
.copy-icon { display: inline-flex; align-items: center; justify-content: center; width: 16px; height: 16px; flex: none; }
.copy-icon svg, .copy-icon morph-icon { display: block; }
.look-shell { min-height: 100vh; }

/* The band holds the header banner (96 px on a phone, 160 px on
 * desktop) and, wrapped below it, the nav row: 96 + gap + the 44 px icon
 * targets on a phone, 160 + gap + the labelled links on desktop. */
.site-header {
  position: relative;
  height: 160px;
  overflow: hidden;
  border-bottom: 1px solid var(--surface-line);
}
.fondo { position: absolute; inset: 0; z-index: 0; pointer-events: none; }
.band {
  position: relative;
  z-index: 1;
  max-width: 1120px;
  height: 100%;
  margin: 0 auto;
  padding: 0 1rem;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 0.6rem;
}
.band-top {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 0.6rem 1rem;
}
.banner-home {
  display: inline-flex;
  flex: none;
}
.banner-home:hover { filter: brightness(1.12); }
.site-nav {
  display: flex;
  gap: 1rem;
  font-family: var(--font-mono);
  font-size: 0.82rem;
}
.site-nav a { color: var(--surface-ink-dim); text-decoration: none; }
.site-nav a:hover { color: var(--surface-ink); text-decoration: underline; text-decoration-color: var(--teal); }

.search { display: flex; gap: 0.5rem; margin: 0; }
main .search { margin: 0 0 1.5rem; }
.sr-only {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0 0 0 0);
  white-space: nowrap;
  border: 0;
}
.search input {
  flex: 1;
  min-width: 0;
  padding: 0.55rem 0.7rem;
  background: var(--bg-deep);
  color: var(--surface-ink);
  border: 1px solid var(--surface-line);
  border-radius: var(--radius-ctl);
  font-family: var(--font-mono);
  font-size: 0.9rem;
}
.search button {
  flex: none;
  padding: 0.55rem 1rem;
  background: var(--tint-info);
  border: 1px solid var(--surface-line);
  border-radius: var(--radius-ctl);
  color: var(--surface-ink);
  font-family: var(--font-mono);
  font-size: 0.85rem;
  cursor: pointer;
}
.search button:hover { border-color: var(--teal); }

main.look-col { max-width: 1120px; margin: 0 auto; padding: 1.5rem 1rem 3.5rem; }

h1, h2, h3 { font-weight: 400; line-height: 1.25; color: var(--ink-hi); }
h1 { margin: 0 0 1rem; font-family: var(--font-mono); font-size: 1.05rem; }
.index-title { font-family: var(--font-mono); font-size: 1.05rem; margin: 0 0 1rem; }
.doc-title {
  font-family: var(--font-display);
  font-size: clamp(1.7rem, 5vw, 2.3rem);
  margin: 0 0 0.5rem;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 0.5rem;
}
.doc-title .icon { width: 24px; height: 24px; }
.kicker {
  margin: 0;
  font-family: var(--font-mono);
  font-size: 0.78rem;
  font-weight: 500;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--surface-ink-dim);
  display: inline-flex;
  align-items: center;
  gap: 0.4rem;
}
h2.kicker { margin: 2rem 0 0.75rem; }
h3.kicker { margin: 1.25rem 0 0.5rem; }
p { margin: 0 0 1rem; }
.description { margin: 0 0 1rem; font-family: var(--font-body); font-size: 1.1rem; color: var(--surface-ink-dim); }

.tabs {
  display: flex;
  flex-wrap: wrap;
  gap: 0.9rem;
  margin: 0 0 1.5rem;
  font-family: var(--font-mono);
  font-size: 0.78rem;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}
.tabs a {
  padding-bottom: 0.15rem;
  border-bottom: 1px solid transparent;
  color: var(--surface-ink-dim);
  text-decoration: none;
}
.tabs a[aria-current="page"] { border-bottom-color: var(--teal); color: var(--surface-ink); }

ol.index {
  list-style: none;
  margin: 0 0 1.5rem;
  padding: 0 1rem;
  background: var(--surface-panel);
  border: 1px solid var(--surface-line);
  border-radius: var(--radius-card);
}
li.row {
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
  gap: 0.35rem 0.75rem;
  padding: 0.7rem 0;
  border-bottom: 1px solid var(--surface-line);
  font-family: var(--font-mono);
  font-size: 0.85rem;
}
li.row:last-child { border-bottom: 0; }
.row-name {
  font-family: var(--font-display);
  font-size: 1.15rem;
  color: var(--surface-ink);
  text-decoration: none;
}
.row-name:hover { text-decoration: underline; text-decoration-color: var(--teal); }
.kind {
  display: inline-flex;
  align-items: center;
  gap: 0.3rem;
  padding: 0.05rem 0.4rem;
  border: 1px solid var(--surface-line);
  border-radius: var(--radius-ctl);
  font-size: 0.72rem;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  color: var(--surface-ink-dim);
}
.row-meta { color: var(--surface-ink-dim); white-space: nowrap; }
.dots { display: inline-flex; gap: 0.3rem; align-self: center; }
.dot {
  display: inline-block;
  width: 0.55rem;
  height: 0.55rem;
  border-radius: 50%;
  background: var(--nc, var(--canopy));
}
/* The command field and its Copy button share one height: each stretches
 * to the other's, so the pair reads as a single control on every host
 * (index rows, datasheet, publish, share panel) — the field painted with
 * the raised command tokens, the command at full ink. */
.row-install { display: inline-flex; gap: 0.5rem; align-items: stretch; margin-left: auto; min-width: 0; }
.row-install code {
  display: flex;
  align-items: center;
  padding: 0.35rem 0.6rem;
  background: var(--command-bg);
  border: 1px solid var(--command-line);
  border-radius: var(--radius-ctl);
  color: var(--surface-ink);
  font-family: var(--font-mono);
  font-size: 0.78rem;
  line-height: 1.5;
  white-space: nowrap;
  overflow-x: auto;
}
.row-desc {
  flex-basis: 100%;
  font-family: var(--font-body);
  font-size: 1rem;
  color: var(--surface-ink-dim);
}

ol.cards {
  list-style: none;
  margin: 0 0 1.5rem;
  padding: 0;
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr));
  gap: 1rem;
}
li.card {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 0.5rem;
  padding: 0.9rem 1rem 1rem;
  background: var(--surface-panel);
  border: 1px solid var(--surface-line);
  border-radius: var(--radius-card);
  font-family: var(--font-mono);
  font-size: 0.85rem;
}
.card-link {
  display: flex;
  flex-direction: column;
  gap: 0.6rem;
  align-self: stretch;
  color: var(--surface-ink);
  text-decoration: none;
}
.card-link:hover .card-title { text-decoration: underline; text-decoration-color: var(--teal); }
.card-title { font-family: var(--font-display); font-size: 1.25rem; }
.card-summary { font-family: var(--font-body); font-size: 1rem; color: var(--surface-ink-dim); }

/* A plate at thumbnail size: the same black stage, cropped, still, and out
 * of the pointer's way. Index rows carry one after their install box. */
figure.thumb { margin: 0; padding: 0.5rem; max-height: 12rem; overflow: hidden; pointer-events: none; }
figure.thumb svg { width: 100%; height: auto; max-height: 11rem; }
figure.thumb .token { display: none; }
li.row figure.thumb { flex-basis: 100%; order: 3; margin-top: 0.5rem; }

.badge-status {
  display: inline-block;
  padding: 0.05rem 0.4rem;
  background: var(--tint-ok);
  border: 1px solid var(--tint-line);
  border-radius: var(--radius-ctl);
  font-family: var(--font-mono);
  font-size: 0.72rem;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  white-space: nowrap;
}
.badge-status.status-in-use { background: var(--tint-info); }
.badge-status.status-experiment { background: var(--tint-warn); }
.doc-title .badge-status { font-size: 0.8rem; }

ul.sources { margin: 0 0 1.5rem; padding-left: 1.25rem; font-family: var(--font-body); font-size: 1.05rem; }
ul.sources li { margin: 0 0 0.35rem; }

.button {
  display: inline-block;
  padding: 0.6rem 1.1rem;
  border: 1px solid var(--tint-line);
  border-radius: var(--radius-ctl);
  background: var(--tint-info);
  color: var(--surface-ink);
  font-family: var(--font-mono);
  font-size: 0.85rem;
  letter-spacing: 0.04em;
  text-decoration: none;
  cursor: pointer;
}
.button:hover { filter: brightness(1.05); }
.copy {
  flex: none;
  padding: 0.35rem 0.7rem;
  background: var(--tint-info);
  border: 1px solid var(--surface-line);
  border-radius: var(--radius-ctl);
  color: var(--surface-ink);
  font-family: var(--font-mono);
  font-size: 0.78rem;
  cursor: pointer;
}
.copy:hover { border-color: var(--teal); }
/* The word swaps between Copy and Copied without resizing the button, so
 * neither the icon nor the row moves while the icon morphs. */
.copy-text { display: inline-block; min-width: 3.4rem; }

.doc-cols { display: flex; flex-direction: column; gap: 1.5rem; margin: 1rem 0 1.5rem; }
dl.sheet {
  margin: 0;
  background: var(--surface-panel);
  border: 1px solid var(--surface-line);
  border-radius: var(--radius-card);
  padding: 0 1rem;
  font-family: var(--font-mono);
  font-size: 0.85rem;
}
.sheet .field {
  display: grid;
  grid-template-columns: 7.5rem minmax(0, 1fr);
  gap: 0.75rem;
  padding: 0.5rem 0;
  border-bottom: 1px solid var(--surface-line);
}
.sheet .field:first-child { border-top: 0; }
.sheet .field:last-child { border-bottom: 0; }
.sheet dt {
  margin: 0;
  font-size: 0.72rem;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--surface-ink-dim);
}
.sheet dd { margin: 0; min-width: 0; overflow-wrap: anywhere; }
.sheet .row-install { margin-left: 0; width: 100%; flex-wrap: wrap; }
.sheet .row-install code { flex: 1 1 12rem; min-width: 0; white-space: normal; overflow-wrap: anywhere; overflow-x: visible; }

figure.plate {
  margin: 0 0 1.5rem;
  padding: 0.75rem;
  max-width: 100%;
  overflow-x: auto;
  background: var(--stage-bg);
  border: 1px solid var(--stage-line);
  border-radius: var(--radius-card);
}
.doc-cols figure.plate { margin: 0; }
.plate svg { display: block; height: auto; margin: 0 auto; }
.plate .plate-v { display: none; }

.readme { font-family: var(--font-body); font-size: 1.05rem; line-height: 1.6; }
.readme h1, .readme h2, .readme h3 {
  font-family: var(--font-body);
  font-weight: 500;
  text-transform: none;
  letter-spacing: 0;
  color: var(--ink-hi);
}
.readme h1 { font-size: 1.6rem; }
.readme h2 { font-size: 1.3rem; }
.readme h3 { font-size: 1.1rem; }
.readme pre {
  padding: 0.75rem;
  background: var(--stage-bg);
  border: 1px solid var(--stage-line);
  border-radius: var(--radius-ctl);
  color: var(--stage-ink);
  font-family: var(--font-mono);
  font-size: 0.82rem;
  overflow-x: auto;
}
.readme code { font-family: var(--font-mono); font-size: 0.9em; }
.readme img { max-width: 100%; height: auto; }
.busy { padding: 0.25rem 0 0.25rem 1rem; border-left: 3px solid var(--teal); }
.busy-error {
  background: var(--tint-error);
  border: 1px solid var(--tint-line);
  border-radius: var(--radius-card);
  padding: 1rem 1.25rem;
}
.busy-error h1 { color: var(--err-label); }
.busy-error p { color: var(--surface-ink); }

.badge-official {
  display: inline-flex;
  align-items: center;
  gap: 0.3rem;
  padding: 0.05rem 0.4rem;
  background: var(--tint-ok);
  border: 1px solid var(--tint-line);
  border-radius: var(--radius-ctl);
  color: var(--surface-ink);
  font-family: var(--font-mono);
  font-size: 0.72rem;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  white-space: nowrap;
}
.badge-official .icon { width: 14px; height: 14px; }
.doc-title .badge-official { font-size: 0.8rem; }
.row-source { color: var(--surface-ink-dim); }

.community-warning {
  margin: 1rem 0 1.5rem;
  padding: 0.9rem 1rem;
  background: var(--tint-warn);
  border: 1px solid var(--tint-line);
  border-left: 3px solid var(--attention);
  border-radius: var(--radius-ctl);
  font-family: var(--font-body);
  font-size: 1.05rem;
  line-height: 1.6;
  display: flex;
  align-items: flex-start;
  gap: 0.6rem;
}
.community-warning p { margin: 0; }
/* The one icon with an ink of its own: the warning triangle, red on the
 * warn tint. Everything else follows currentColor. */
.community-warning .icon { color: var(--warn-icon); margin-top: 0.35rem; }
.install-review { margin: 0.4rem 0 0; font-family: var(--font-mono); font-size: 0.78rem; color: var(--surface-ink-dim); }

.runs-summary { font-family: var(--font-mono); font-size: 0.85rem; }
.runs-summary.runs-community {
  background: var(--tint-warn);
  border: 1px solid var(--tint-line);
  border-radius: var(--radius-ctl);
  padding: 0.6rem 0.75rem;
}
.run { margin: 0 0 1rem; }
.run-where { font-family: var(--font-mono); font-size: 0.82rem; }
p.run-where { margin: 0 0 0.35rem; }
pre.run-command, pre.run-prompt-text {
  margin: 0;
  padding: 0.75rem;
  max-width: 100%;
  background: var(--stage-bg);
  border: 1px solid var(--stage-line);
  border-radius: var(--radius-ctl);
  color: var(--stage-ink);
  font-family: var(--font-mono);
  font-size: 0.82rem;
  line-height: 1.5;
  white-space: pre-wrap;
  overflow-wrap: anywhere;
  overflow-x: auto;
}
pre.run-command code, pre.run-prompt-text code { font-family: inherit; overflow-wrap: anywhere; }
.attention-chip {
  display: inline-block;
  margin-left: 0.4rem;
  padding: 0.05rem 0.4rem;
  border: 1px solid var(--attention);
  border-radius: var(--radius-ctl);
  color: var(--attention);
  font-family: var(--font-mono);
  font-size: 0.72rem;
  white-space: nowrap;
}
details.run-prompt {
  margin: 0 0 0.75rem;
  padding: 0.6rem 0.75rem;
  background: var(--stage-bg);
  border: 1px solid var(--stage-line);
  border-radius: var(--radius-ctl);
}
details.run-prompt summary { cursor: pointer; }
details.run-prompt summary .run-where { color: var(--surface-ink); }
.run-preview {
  display: block;
  margin-top: 0.25rem;
  color: var(--surface-ink-dim);
  font-family: var(--font-mono);
  font-size: 0.82rem;
  white-space: pre-line;
  overflow-wrap: anywhere;
}
.run-builtin { margin: 0.5rem 0 0; font-family: var(--font-mono); font-size: 0.82rem; color: var(--surface-ink-dim); }
details.run-prompt pre.run-prompt-text { margin-top: 0.5rem; }

/* Under 520 px the header's four links show their icon alone, so the row
 * stays one line on a small screen: the label leaves the layout but stays
 * in the accessibility tree through the link's aria-label and title, and
 * each link is a 44 px square target (the 639 block below adds the
 * height). The banner is 253 px wide under 640 px (banner.css); the four
 * labelled links need about 330 px beside it, so above 519 px the band-top
 * wraps them onto a second row inside the band's height. */
@media (max-width: 519px) {
  .site-nav { gap: 0.25rem; }
  .site-nav a { min-width: 44px; justify-content: center; }
  .site-nav a span { display: none; }
}
@media (max-width: 639px) {
  .plate .plate-h { display: none; }
  .plate .plate-v { display: block; }
  /* Phones: every control that holds an icon alone is a 44 × 44 target. */
  .copy { min-width: 44px; min-height: 44px; justify-content: center; }
  .search button, .site-nav a { min-height: 44px; }
}
@media (max-width: 899px) {
  .row-desc { order: 1; }
  .row-install { order: 2; flex-basis: 100%; margin-left: 0; }
  .row-install code { flex: 1; }
}
@media (min-width: 640px) {
  .site-header { height: 200px; }
  .band { padding: 0 1.5rem; }
  main.look-col { padding: 2rem 1.5rem 4rem; }
}
@media (min-width: 1024px) {
  .doc-cols { flex-direction: row; align-items: flex-start; }
  .doc-cols figure.plate { flex: 1; min-width: 0; }
  dl.sheet { flex: 0 0 320px; }
}
@media (prefers-reduced-motion: reduce) {
  * { transition: none !important; animation: none !important; }
}
</style>
</head>
<body>
<div class="look-shell">
<header class="site-header">
<div class="fondo" id="fondo" aria-hidden="true"></div>
<div class="band">
<div class="band-top">
<a class="banner-home" href="/" aria-label="Canopy graphs, home"><svg viewBox="0 0 58 22" shape-rendering="crispEdges" class="look-banner-header look-banner-header-graphs" role="img" aria-label="Canopy graphs"><g class="look-banner-line" fill="#52fff6"><rect x="40" y="0" width="5" height="2"/></g><g class="look-banner-line" fill="#52fff6"><rect x="39" y="2" width="2" height="2" fill-opacity=".35"/><rect x="41" y="2" width="3" height="2"/></g><g class="look-banner-line" fill="#1ffff3"><rect x="2" y="4" width="7" height="2"/><rect x="10" y="4" width="8" height="2"/><rect x="21" y="4" width="6" height="2"/><rect x="30" y="4" width="8" height="2"/><rect x="40" y="4" width="1" height="2" fill-opacity=".35"/><rect x="41" y="4" width="7" height="2"/><rect x="52" y="4" width="5" height="2"/></g><g class="look-banner-line" fill="#1ffff3"><rect x="1" y="6" width="3" height="2"/><rect x="4" y="6" width="2" height="2" fill-opacity=".35"/><rect x="6" y="6" width="3" height="2"/><rect x="9" y="6" width="2" height="2" fill-opacity=".35"/><rect x="11" y="6" width="3" height="2"/><rect x="14" y="6" width="2" height="2" fill-opacity=".35"/><rect x="16" y="6" width="3" height="2"/><rect x="20" y="6" width="5" height="2" fill-opacity=".35"/><rect x="25" y="6" width="3" height="2"/><rect x="29" y="6" width="2" height="2" fill-opacity=".35"/><rect x="31" y="6" width="3" height="2"/><rect x="34" y="6" width="2" height="2" fill-opacity=".35"/><rect x="36" y="6" width="3" height="2"/><rect x="40" y="6" width="1" height="2" fill-opacity=".35"/><rect x="41" y="6" width="3" height="2"/><rect x="44" y="6" width="2" height="2" fill-opacity=".35"/><rect x="46" y="6" width="3" height="2"/><rect x="51" y="6" width="3" height="2"/><rect x="54" y="6" width="2" height="2" fill-opacity=".35"/></g><g class="look-banner-line" fill="#1ffff3"><rect x="0" y="8" width="1" height="2" fill-opacity=".35"/><rect x="1" y="8" width="3" height="2"/><rect x="5" y="8" width="1" height="2" fill-opacity=".35"/><rect x="6" y="8" width="3" height="2"/><rect x="10" y="8" width="1" height="2" fill-opacity=".35"/><rect x="11" y="8" width="3" height="2"/><rect x="15" y="8" width="3" height="2" fill-opacity=".35"/><rect x="21" y="8" width="7" height="2"/><rect x="30" y="8" width="1" height="2" fill-opacity=".35"/><rect x="31" y="8" width="3" height="2"/><rect x="35" y="8" width="1" height="2" fill-opacity=".35"/><rect x="36" y="8" width="3" height="2"/><rect x="40" y="8" width="1" height="2" fill-opacity=".35"/><rect x="41" y="8" width="3" height="2"/><rect x="45" y="8" width="1" height="2" fill-opacity=".35"/><rect x="46" y="8" width="3" height="2"/><rect x="50" y="8" width="2" height="2" fill-opacity=".35"/><rect x="52" y="8" width="5" height="2"/></g><g class="look-banner-line" fill="#00e0d4"><rect x="0" y="10" width="1" height="2" fill-opacity=".35"/><rect x="1" y="10" width="3" height="2"/><rect x="5" y="10" width="1" height="2" fill-opacity=".35"/><rect x="6" y="10" width="3" height="2"/><rect x="10" y="10" width="1" height="2" fill-opacity=".35"/><rect x="11" y="10" width="3" height="2"/><rect x="20" y="10" width="3" height="2"/><rect x="23" y="10" width="2" height="2" fill-opacity=".35"/><rect x="25" y="10" width="3" height="2"/><rect x="30" y="10" width="1" height="2" fill-opacity=".35"/><rect x="31" y="10" width="3" height="2"/><rect x="35" y="10" width="1" height="2" fill-opacity=".35"/><rect x="36" y="10" width="3" height="2"/><rect x="40" y="10" width="1" height="2" fill-opacity=".35"/><rect x="41" y="10" width="3" height="2"/><rect x="45" y="10" width="1" height="2" fill-opacity=".35"/><rect x="46" y="10" width="3" height="2"/><rect x="51" y="10" width="4" height="2" fill-opacity=".35"/><rect x="55" y="10" width="3" height="2"/></g><g class="look-banner-line" fill="#00e0d4"><rect x="0" y="12" width="2" height="2" fill-opacity=".35"/><rect x="2" y="12" width="7" height="2"/><rect x="10" y="12" width="5" height="2"/><rect x="19" y="12" width="2" height="2" fill-opacity=".35"/><rect x="21" y="12" width="8" height="2"/><rect x="30" y="12" width="1" height="2" fill-opacity=".35"/><rect x="31" y="12" width="7" height="2"/><rect x="40" y="12" width="4" height="2"/><rect x="45" y="12" width="5" height="2"/><rect x="51" y="12" width="6" height="2"/></g><g class="look-banner-line" fill="#00a9a0"><rect x="1" y="14" width="5" height="2" fill-opacity=".35"/><rect x="6" y="14" width="3" height="2"/><rect x="9" y="14" width="5" height="2" fill-opacity=".35"/><rect x="20" y="14" width="8" height="2" fill-opacity=".35"/><rect x="30" y="14" width="1" height="2" fill-opacity=".35"/><rect x="31" y="14" width="3" height="2"/><rect x="34" y="14" width="3" height="2" fill-opacity=".35"/><rect x="39" y="14" width="4" height="2" fill-opacity=".35"/><rect x="44" y="14" width="5" height="2" fill-opacity=".35"/><rect x="50" y="14" width="6" height="2" fill-opacity=".35"/></g><g class="look-banner-line" fill="#00a9a0"><rect x="1" y="16" width="3" height="2"/><rect x="5" y="16" width="1" height="2" fill-opacity=".35"/><rect x="6" y="16" width="3" height="2"/><rect x="30" y="16" width="1" height="2" fill-opacity=".35"/><rect x="31" y="16" width="3" height="2"/></g><g class="look-banner-line" fill="#00a9a0"><rect x="0" y="18" width="2" height="2" fill-opacity=".35"/><rect x="2" y="18" width="6" height="2"/><rect x="30" y="18" width="5" height="2"/></g><g class="look-banner-line" fill="#006661"><rect x="1" y="20" width="6" height="2" fill-opacity=".35"/><rect x="29" y="20" width="5" height="2" fill-opacity=".35"/></g></svg></a>
