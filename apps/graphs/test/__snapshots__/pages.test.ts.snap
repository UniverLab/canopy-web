exports[`route snapshots > renders / with the official listing first 1`] = `
"<!doctype html>
<html lang="en" data-surface="tui">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>graphs.univerlab.org · graphs.univerlab.org</title>
<meta name="description" content="A catalogue of Canopy graphs and nodes.">
<link rel="stylesheet" href="/look/tokens.css">
<link rel="stylesheet" href="/look/fonts/fonts.css">
<link rel="stylesheet" href="/look/colophon/colophon.css">
<style>
*, *::before, *::after { box-sizing: border-box; }
html {
  background: var(--surface-bg);
  color-scheme: dark;
}
body {
  margin: 0;
  min-height: 100vh;
  background: var(--surface-bg);
  color: var(--surface-ink);
  font-family: var(--font-mono);
  font-size: 0.9375rem;
  line-height: 1.55;
  -webkit-text-size-adjust: 100%;
}
a { color: var(--teal); text-underline-offset: 0.15em; }
a:hover { text-decoration-thickness: 2px; }
:focus-visible { outline: 2px solid var(--teal); outline-offset: 3px; }
.look-shell { min-height: 100vh; }

.site-header {
  position: relative;
  height: 120px;
  overflow: hidden;
  border-bottom: 1px solid var(--surface-line);
}
.fondo { position: absolute; inset: 0; z-index: 0; pointer-events: none; }
.band {
  position: relative;
  z-index: 1;
  max-width: 1120px;
  height: 100%;
  margin: 0 auto;
  padding: 0 1rem;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 0.6rem;
}
.band-top {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 1rem;
}
.wordmark {
  display: inline-block;
  padding-bottom: 0.15rem;
  border-bottom: 1px solid var(--surface-line);
  font-family: var(--font-mono);
  font-size: 1rem;
  letter-spacing: 0.08em;
  color: var(--surface-ink);
  text-decoration: none;
}
.wordmark:hover { border-bottom-color: var(--teal); }
.site-nav {
  display: flex;
  gap: 1rem;
  font-family: var(--font-mono);
  font-size: 0.82rem;
}
.site-nav a { color: var(--surface-ink-dim); text-decoration: none; }
.site-nav a:hover { color: var(--surface-ink); text-decoration: underline; text-decoration-color: var(--teal); }

.search { display: flex; gap: 0.5rem; margin: 0; }
.sr-only {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0 0 0 0);
  white-space: nowrap;
  border: 0;
}
.search input {
  flex: 1;
  min-width: 0;
  padding: 0.55rem 0.7rem;
  background: var(--bg-deep);
  color: var(--surface-ink);
  border: 1px solid var(--surface-line);
  border-radius: var(--radius-ctl);
  font-family: var(--font-mono);
  font-size: 0.9rem;
}
.search button {
  flex: none;
  padding: 0.55rem 1rem;
  background: transparent;
  border: 1px solid var(--surface-line);
  border-radius: var(--radius-ctl);
  color: var(--surface-ink);
  font-family: var(--font-mono);
  font-size: 0.85rem;
  cursor: pointer;
}
.search button:hover { border-color: var(--teal); }

main.look-col { max-width: 1120px; margin: 0 auto; padding: 1.5rem 1rem 3.5rem; }

h1, h2, h3 { font-weight: 400; line-height: 1.25; color: var(--ink-hi); }
h1 { margin: 0 0 1rem; font-family: var(--font-mono); font-size: 1.05rem; }
.index-title { font-family: var(--font-mono); font-size: 1.05rem; margin: 0 0 1rem; }
.doc-title { font-family: var(--font-display); font-size: clamp(1.7rem, 5vw, 2.3rem); margin: 0 0 0.5rem; }
.kicker {
  margin: 0;
  font-family: var(--font-mono);
  font-size: 0.78rem;
  font-weight: 500;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--surface-ink-dim);
}
h2.kicker { margin: 2rem 0 0.75rem; }
h3.kicker { margin: 1.25rem 0 0.5rem; }
p { margin: 0 0 1rem; }
.description { margin: 0 0 1rem; font-family: var(--font-body); font-size: 1.1rem; color: var(--surface-ink-dim); }

.tabs {
  display: flex;
  flex-wrap: wrap;
  gap: 0.9rem;
  margin: 0 0 1.5rem;
  font-family: var(--font-mono);
  font-size: 0.78rem;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}
.tabs a {
  padding-bottom: 0.15rem;
  border-bottom: 1px solid transparent;
  color: var(--surface-ink-dim);
  text-decoration: none;
}
.tabs a[aria-current="page"] { border-bottom-color: var(--teal); color: var(--surface-ink); }

ol.index {
  list-style: none;
  margin: 0 0 1.5rem;
  padding: 0;
  border-top: 1px solid var(--surface-line);
}
li.row {
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
  gap: 0.35rem 0.75rem;
  padding: 0.7rem 0;
  border-bottom: 1px solid var(--surface-line);
  font-family: var(--font-mono);
  font-size: 0.85rem;
}
.row-name {
  font-family: var(--font-display);
  font-size: 1.15rem;
  color: var(--surface-ink);
  text-decoration: none;
}
.row-name:hover { text-decoration: underline; text-decoration-color: var(--teal); }
.kind {
  padding: 0.05rem 0.4rem;
  border: 1px solid var(--surface-line);
  border-radius: var(--radius-ctl);
  font-size: 0.72rem;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  color: var(--surface-ink-dim);
}
.row-meta { color: var(--surface-ink-dim); white-space: nowrap; }
.dots { display: inline-flex; gap: 0.3rem; align-self: center; }
.dot {
  display: inline-block;
  width: 0.55rem;
  height: 0.55rem;
  border-radius: 50%;
  background: var(--nc, var(--canopy));
}
.row-install { display: inline-flex; gap: 0.5rem; align-items: center; margin-left: auto; min-width: 0; }
.row-install code {
  padding: 0.35rem 0.6rem;
  background: var(--bg-deep);
  border: 1px solid var(--surface-line);
  border-radius: var(--radius-ctl);
  color: var(--surface-ink);
  font-family: var(--font-mono);
  font-size: 0.78rem;
  line-height: 1.5;
  white-space: nowrap;
  overflow-x: auto;
}
.row-desc {
  flex-basis: 100%;
  font-family: var(--font-body);
  font-size: 1rem;
  color: var(--surface-ink-dim);
}

.button {
  display: inline-block;
  padding: 0.6rem 1.1rem;
  border: 0;
  border-radius: var(--radius-ctl);
  background: var(--cta-gradient);
  color: #012624;
  font-family: var(--font-mono);
  font-size: 0.85rem;
  letter-spacing: 0.04em;
  text-decoration: none;
  cursor: pointer;
}
.button:hover { filter: brightness(1.05); }
.copy {
  flex: none;
  padding: 0.35rem 0.7rem;
  background: transparent;
  border: 1px solid var(--surface-line);
  border-radius: var(--radius-ctl);
  color: var(--surface-ink);
  font-family: var(--font-mono);
  font-size: 0.78rem;
  cursor: pointer;
}
.copy:hover { border-color: var(--teal); }

.doc-cols { display: flex; flex-direction: column; gap: 1.5rem; margin: 1rem 0 1.5rem; }
dl.sheet { margin: 0; font-family: var(--font-mono); font-size: 0.85rem; }
.sheet .field {
  display: grid;
  grid-template-columns: 7.5rem minmax(0, 1fr);
  gap: 0.75rem;
  padding: 0.5rem 0;
  border-bottom: 1px solid var(--surface-line);
}
.sheet .field:first-child { border-top: 1px solid var(--surface-line); }
.sheet dt {
  margin: 0;
  font-size: 0.72rem;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--surface-ink-dim);
}
.sheet dd { margin: 0; min-width: 0; overflow-wrap: anywhere; }
.sheet .row-install { margin-left: 0; width: 100%; }
.sheet .row-install code { flex: 1; min-width: 0; }

figure.plate {
  margin: 0 0 1.5rem;
  padding: 0.75rem;
  max-width: 100%;
  overflow-x: auto;
  background: var(--bg-deep);
  border: 1px solid var(--surface-line);
  border-radius: var(--radius-card);
}
.doc-cols figure.plate { margin: 0; }
.plate svg { display: block; height: auto; margin: 0 auto; }
.plate .plate-v { display: none; }

.readme { font-family: var(--font-body); font-size: 1.05rem; line-height: 1.6; }
.readme h1, .readme h2, .readme h3 {
  font-family: var(--font-body);
  font-weight: 500;
  text-transform: none;
  letter-spacing: 0;
  color: var(--ink-hi);
}
.readme h1 { font-size: 1.6rem; }
.readme h2 { font-size: 1.3rem; }
.readme h3 { font-size: 1.1rem; }
.readme pre {
  padding: 0.75rem;
  background: var(--bg-deep);
  border: 1px solid var(--surface-line);
  border-radius: var(--radius-ctl);
  font-family: var(--font-mono);
  font-size: 0.82rem;
  overflow-x: auto;
}
.readme code { font-family: var(--font-mono); font-size: 0.9em; }
.readme img { max-width: 100%; height: auto; }
.busy { padding: 0.25rem 0 0.25rem 1rem; border-left: 3px solid var(--teal); }

@media (max-width: 639px) {
  .plate .plate-h { display: none; }
  .plate .plate-v { display: block; }
}
@media (max-width: 899px) {
  .row-desc { order: 1; }
  .row-install { order: 2; flex-basis: 100%; margin-left: 0; }
  .row-install code { flex: 1; }
}
@media (min-width: 640px) {
  .site-header { height: 160px; }
  .band { padding: 0 1.5rem; }
  main.look-col { padding: 2rem 1.5rem 4rem; }
}
@media (min-width: 1024px) {
  .doc-cols { flex-direction: row; align-items: flex-start; }
  .doc-cols figure.plate { flex: 1; min-width: 0; }
  dl.sheet { flex: 0 0 320px; }
}
@media (prefers-reduced-motion: reduce) {
  * { transition: none !important; animation: none !important; }
}
</style>
</head>
<body>
<div class="look-shell">
<header class="site-header">
<div class="fondo" id="fondo" aria-hidden="true"></div>
<div class="band">
<div class="band-top">
<a class="wordmark" href="https://univerlab.org/canopy/">graphs</a>
<nav class="site-nav" aria-label="Catalogue">
<a href="/publish">Publish</a>
<a href="https://github.com/UniverLab/canopy-web">Source</a>
</nav>
</div>
<form class="search" action="/search" method="get" role="search"><label class="sr-only" for="q">Search graphs and nodes</label><input id="q" name="q" type="search" value="" placeholder="hello-graph" autocomplete="off"><button type="submit">Search</button></form>
</div>
</header>
<main class="look-col">
<h1 class="index-title">A catalogue of Canopy graphs and nodes.</h1>
<nav class="tabs"><a href="/search?sort=top">Top</a><a href="/search?sort=new">New</a></nav>
<h2 class="kicker">Official</h2>
<h3 class="kicker">Graphs</h3>
<ol class="index"><li class="row"><a class="row-name" href="/g/hello-graph">hello-graph</a><span class="kind">graph</span><span class="row-meta">5 nodes</span><span class="row-meta">7 stars</span><span class="row-install"><code>canopy graph install hello-graph</code><button type="button" class="copy" data-copy="canopy graph install hello-graph" aria-label="Copy the install command to the clipboard">Copy</button></span><span class="row-desc">Five nodes with one fail edge, for the drawing test.</span></li></ol>
<h3 class="kicker">Nodes</h3>
<ol class="index"><li class="row"><a class="row-name" href="/n/hello-node">hello-node</a><span class="kind">node</span><span class="row-meta">7 stars</span><span class="row-install"><code>canopy node install hello-node</code><button type="button" class="copy" data-copy="canopy node install hello-node" aria-label="Copy the install command to the clipboard">Copy</button></span><span class="row-desc">Example catalogue node: drafts an implementation plan.</span></li></ol>
</main>
<footer class="look-colophon">
  <picture class="colophon-band" aria-hidden="true">
    <source type="image/avif" srcset="/look/colophon/frieze-960.avif 960w, /look/colophon/frieze-1920.avif 1920w" sizes="100vw">
    <img src="/look/colophon/frieze-1920.webp" srcset="/look/colophon/frieze-960.webp 960w, /look/colophon/frieze-1920.webp 1920w" sizes="100vw" width="1920" height="608" alt="" loading="lazy" decoding="async">
  </picture>
  <div class="colophon-content">
    <div class="colophon-brand">
      <p class="colophon-title">Canopy graphs</p>
      <p class="colophon-sub">Part of UniverLab · EXP-001 Canopy graphs</p>
    </div>
    <nav class="colophon-col" aria-label="UniverLab">
      <p class="colophon-label">UniverLab</p>
      <a href="https://univerlab.org/canopy/" target="_blank" rel="noopener noreferrer">Canopy</a>
      <a href="https://univerlab.org/" target="_blank" rel="noopener noreferrer">univerlab.org</a>
      <a href="https://github.com/UniverLab/canopy-web" target="_blank" rel="noopener noreferrer">Source</a>
    </nav>
    <p class="colophon-credits">
      <img src="/look/colophon/sello-lacre.svg" width="28" height="28" alt="" aria-hidden="true">
      <span>Artifact conceived and forged at <a href="https://univerlab.org" target="_blank" rel="noopener noreferrer">UniverLab</a></span>
    </p>
  </div>
</footer>

</div>
<script src="/look/fondo.js" defer></script>
<script>
(function(){function start(){var host=document.getElementById("fondo");if(!host||!window.CanopyLook||!window.CanopyLook.mountCanopyBackground){return}window.CanopyLook.mountCanopyBackground(host,"/look/fondo/assets/")}if(document.readyState==="loading"){document.addEventListener("DOMContentLoaded",start)}else{start()}})();
</script>
<script>
(function(){document.addEventListener("click",function(event){var target=event.target;if(!target||!target.classList||!target.classList.contains("copy")){return}var command=target.getAttribute("data-copy")||"";if(navigator.clipboard){navigator.clipboard.writeText(command)}var original=target.textContent;target.textContent="Copied";window.setTimeout(function(){target.textContent=original},1500);});})();
</script>
</body>
</html>
"
`;

