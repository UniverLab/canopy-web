lass="edge fail" d="M39.45 17.6 C39.45 10 13.45 10 13.45 17.6" data-from="test" data-to="build"/></g><g class="groups"></g><g class="nodes"><g class="node shape-agent" data-name="build" data-cx="13.45" data-cy="20.6" data-w="6" data-h="6" data-rank="0" data-lane="main"><title>build (agent)</title><rect class="shape" x="10.45" y="17.6" width="6" height="6" rx="3"/><text class="label" x="13.45" y="20.6" dy="6.4">build</text></g><g class="node shape-check" data-name="test" data-cx="39.45" data-cy="20.6" data-w="5.6" data-h="5.6" data-rank="1" data-lane="main"><title>test (check)</title><rect class="shape" x="36.650000000000006" y="17.8" width="5.6" height="5.6" rx="0.7"/><text class="label" x="39.45" y="20.6" dy="6.4">test</text></g><g class="node shape-gate" data-name="gate" data-cx="65.45" data-cy="20.6" data-w="5" data-h="5" data-rank="2" data-lane="main"><title>gate (gate)</title><rect class="shape" x="62.95" y="18.1" width="5" height="5" rx="0.5" transform="rotate(45 65.45 20.6)"/><text class="label" x="65.45" y="20.6" dy="6.4">gate</text></g><g class="node shape-gate" data-name="triage" data-cx="91.45" data-cy="20.6" data-w="5" data-h="5" data-rank="3" data-lane="main"><title>triage (router)</title><rect class="shape" x="88.95" y="18.1" width="5" height="5" rx="0.5" transform="rotate(45 91.45 20.6)"/><text class="label" x="91.45" y="20.6" dy="6.4">triage</text></g><g class="node shape-agent" data-name="docs" data-cx="117.45" data-cy="20.6" data-w="6" data-h="6" data-rank="4" data-lane="main"><title>docs (agent)</title><rect class="shape" x="114.45" y="17.6" width="6" height="6" rx="3"/><text class="label" x="117.45" y="20.6" dy="6.4">docs</text></g></g><circle class="token" r="1.1" cx="13.45" cy="20.6"><animateMotion dur="3.6s" repeatCount="indefinite" path="M13.45 20.6C26.45 20.6 26.45 20.6 39.45 20.6C52.45 20.6 52.45 20.6 65.45 20.6C78.45 20.6 78.45 20.6 91.45 20.6C104.45 20.6 104.45 20.6 117.45 20.6"/></circle></svg></figure>
