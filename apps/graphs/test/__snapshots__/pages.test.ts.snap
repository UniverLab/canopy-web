    </nav>
    <p class="colophon-credits">
      <img src="/look/colophon/sello-lacre.svg" width="28" height="28" alt="" aria-hidden="true">
      <span>Artifact conceived and forged at <a href="https://univerlab.org" target="_blank" rel="noopener noreferrer">UniverLab</a></span>
    </p>
  </div>
</footer>

</div>
<script src="/look/fondo.js" defer></script>
<script src="/look/icons.js" defer></script>
<script>
(function(){function start(){var host=document.getElementById("fondo");if(!host||!window.CanopyLook||!window.CanopyLook.mountCanopyBackground){return}window.CanopyLook.mountCanopyBackground(host,"/look/fondo/assets/")}if(document.readyState==="loading"){document.addEventListener("DOMContentLoaded",start)}else{start()}})();
</script>
<script>
(function(){function start(){if(window.CanopyIcons&&window.CanopyIcons.mountCopyButtons){window.CanopyIcons.mountCopyButtons(document)}}if(document.readyState==="loading"){document.addEventListener("DOMContentLoaded",start)}else{start()}})();
</script>
<script>
(function(){function modelContext(){function from(h){var mc=h&&h.modelContext;return mc&&typeof mc.registerTool==="function"?mc:null}var d=(typeof document!=="undefined")?from(document):null;if(d){return d}return (typeof navigator!=="undefined")?from(navigator):null}function schedule(fn){if(typeof window!=="undefined"&&typeof window.requestIdleCallback==="function"){window.requestIdleCallback(fn,{timeout:2000})}else{setTimeout(fn,0)}}function str(v){return typeof v==="string"?v.trim():""}function fetchText(path,signal){return fetch(path,{signal:signal}).then(function(r){return r.text()}).catch(function(){return "The catalogue API is unavailable right now; try again in a moment."})}function opt(){return " Official documents live under UniverLab/canopy-graphs."}function one(kind,input,opts){var owner=str(input.owner),repo=str(input.repo),slug=str(input.slug);if(!owner||!repo||!slug){return Promise.resolve("Usage: one " + kind + " needs owner, repo and slug." + opt())}var signal=opts&&opts.signal?opts.signal:undefined;return fetchText("/api/" + (kind === "graph" ? "g" : "n") + "/" + encodeURIComponent(owner) + "/" + encodeURIComponent(repo) + "/" + encodeURIComponent(slug),signal)}function search(input,opts){var q=str(input.q);var sort=str(input.sort)==="new"?"new":"top";var raw=input.page;var page=(typeof raw==="number")?raw:parseInt(str(raw)||"1",10);if(!isFinite(page)||page<1){page=1}var signal=opts&&opts.signal?opts.signal:undefined;return fetchText("/api/search?q=" + encodeURIComponent(q) + "&sort=" + sort + "&page=" + page,signal)}function tools(){return [{name:"search_catalogue",title:"Search the catalogue",description:"Search the Canopy graph and node catalogue: free text over names, descriptions and repos, top or new order, 20-item pages. Read-only, served from the scheduled index.",inputSchema:{type:"object",properties:{q:{type:"string",description:"Free text over name, slug, description and owner/repo."},sort:{type:"string",enum:["top","new"],description:"top orders by stars, new by updated."},page:{type:"integer",minimum:1,description:"One-based page over 20-item pages."}},additionalProperties:false},annotations:{readOnlyHint:true},execute:function(input,opts){return search(input||{},opts)}},{name:"get_graph",title:"Get one graph",description:"Fetch one graph document by owner, repo and slug, with its catalogue row. Read-only." + opt(),inputSchema:{type:"object",properties:{owner:{type:"string",description:"The GitHub owner."},repo:{type:"string",description:"The GitHub repository."},slug:{type:"string",description:"The document slug."}},required:["owner","repo","slug"],additionalProperties:false},annotations:{readOnlyHint:true},execute:function(input,opts){return one("graph",input||{},opts)}},{name:"get_node",title:"Get one node",description:"Fetch one node document by owner, repo and slug, with its catalogue row. Read-only." + opt(),inputSchema:{type:"object",properties:{owner:{type:"string",description:"The GitHub owner."},repo:{type:"string",description:"The GitHub repository."},slug:{type:"string",description:"The document slug."}},required:["owner","repo","slug"],additionalProperties:false},annotations:{readOnlyHint:true},execute:function(input,opts){return one("node",input||{},opts)}}]}function start(){var mc=modelContext();if(!mc){return}var list=tools();Promise.all(list.map(function(t){return mc.registerTool(t)})).catch(function(){})}schedule(start)})();
