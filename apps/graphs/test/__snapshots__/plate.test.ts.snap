exports[`the node plate > draws an ensemble node as a group of numbered member chips 1`] = `"<svg class="plate-svg plate-h" viewBox="0 0 46.52 54" width="233" height="270" role="img" xmlns="http://www.w3.org/2000/svg"><title>ensemble-proposers</title><desc>Ensembles: ensemble-proposers.</desc><style>.plate-svg text{font-family:var(--font-mono,'Sometype Mono',ui-monospace,Menlo,monospace)}.plate-svg .edge{fill:none;stroke:var(--canopy,#00a9a0);stroke-width:.45;opacity:.85}.plate-svg .edge.fail{stroke:#ff6b6b;stroke-dasharray:1.4 1.1;opacity:.7}.plate-svg .edge.error{stroke:var(--attention,#ffb454);stroke-width:.3;stroke-dasharray:.4 .8;opacity:.55}.plate-svg .edge.bus{stroke-width:.5;opacity:.85}.plate-svg .edge.order{stroke:currentColor;stroke-width:.3;stroke-dasharray:.5 1.1;stroke-linecap:round;opacity:.9}.plate-svg #plate-arrow path{fill:var(--canopy,#00a9a0);fill-opacity:.85}.plate-svg #plate-arrow-fail path{fill:#ff6b6b;fill-opacity:.7}.plate-svg #plate-arrow-error path{fill:var(--attention,#ffb454);fill-opacity:.7}.plate-svg .node .shape{fill:color-mix(in srgb, var(--nc, var(--canopy, #00a9a0)) 22%, #04110f);stroke:var(--nc, var(--canopy, #00a9a0));stroke-width:.45}.plate-svg .shape-chip .shape{fill:#0c1416;stroke:var(--ink-dim,#9a9890)}.plate-svg .shape-check .shape,.plate-svg .shape-gate .shape{fill:#0c1416;stroke:#e8f6f1}.plate-svg .shape-commit .shape{fill:color-mix(in srgb, var(--canopy, #00a9a0) 35%, #04110f);stroke:var(--canopy,#00a9a0)}.plate-svg .label{font-size:2.3px;fill:#e8f6f1}.plate-svg .harness{font-size:1.9px;fill:var(--nc, var(--canopy, #00a9a0));opacity:.9}.plate-svg .group-box{fill:none;stroke:var(--canopy,#00a9a0);stroke-width:.3;stroke-dasharray:1.2 .9;opacity:.8}.plate-svg .group-title,.plate-svg .group-subtitle{font-size:1.9px;fill:var(--canopy,#00a9a0);letter-spacing:.14em;text-transform:uppercase}.plate-svg .member-shape{fill:color-mix(in srgb, var(--nc, var(--canopy, #00a9a0)) 22%, #04110f);stroke:var(--nc, var(--canopy, #00a9a0));stroke-width:.3}.plate-svg .member-label{font-size:1.9px;fill:#e8f6f1;text-anchor:middle}.plate-svg .mark-error{fill:var(--attention,#ffb454);font-size:2.6px;text-anchor:middle}.plate-svg .mark-fail{fill:none;stroke:#ff6b6b;stroke-width:.5;stroke-dasharray:.6 .5}.plate-svg .done{font-size:2px;fill:var(--canopy,#00a9a0);letter-spacing:.04em}.plate-svg .token{fill:var(--canopy,#00a9a0)}@media (prefers-reduced-motion:reduce){.plate-svg .token{display:none}}</style><defs><marker id="plate-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="1.3" markerHeight="1.3" markerUnits="userSpaceOnUse" orient="auto-start-reverse"><path d="M0 0L10 5L0 10z"/></marker><marker id="plate-arrow-fail" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="1.3" markerHeight="1.3" markerUnits="userSpaceOnUse" orient="auto-start-reverse"><path d="M0 0L10 5L0 10z"/></marker><marker id="plate-arrow-error" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="1.3" markerHeight="1.3" markerUnits="userSpaceOnUse" orient="auto-start-reverse"><path d="M0 0L10 5L0 10z"/></marker></defs><g class="edges"><path class="edge order" d="M23.26 22.5 L23.26 29.5" data-from="ensemble-proposers" data-to="ensemble-proposers"/><path class="edge order" d="M23.26 29.5 L23.26 36.5" data-from="ensemble-proposers" data-to="ensemble-proposers"/></g><g class="groups"><g class="ensemble" data-name="ensemble-proposers"><rect class="group-box" x="10.000000000000002" y="10" width="26.52" height="34" rx="2"/><text class="group-title" x="12.000000000000002" y="13.4">ENSEMBLE-PROPOSERS</text><text class="group-subtitle" x="12.000000000000002" y="15.8">PARALLEL · 3/3</text><g class="member" data-name="ensemble-proposers" data-i="1" data-cx="23.26" data-cy="22.5"><rect class="member-shape" x="16.26" y="20.5" width="14" height="4" rx="1"/><text class="member-label" x="23.26" y="22.5" dy="0.7">1</text></g><g class="member" data-name="ensemble-proposers" data-i="2" data-cx="23.26" data-cy="29.5"><rect class="member-shape" x="16.26" y="27.5" width="14" height="4" rx="1"/><text class="member-label" x="23.26" y="29.5" dy="0.7">2</text></g><g class="member" data-name="ensemble-proposers" data-i="3" data-cx="23.26" data-cy="36.5"><rect class="member-shape" x="16.26" y="34.5" width="14" height="4" rx="1"/><text class="member-label" x="23.26" y="36.5" dy="0.7">3</text></g></g></g><g class="nodes"></g><g class="marks"></g><g class="dones"></g></svg>"`;

