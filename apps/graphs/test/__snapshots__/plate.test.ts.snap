exports[`plate invariants > draws a round-robin group's third subtitle shape 1`] = `"<svg class="plate-svg plate-h" viewBox="0 0 79.74 47" width="399" height="235" role="img" xmlns="http://www.w3.org/2000/svg"><title>round-robin</title><desc>Nodes in order: before, after. Ensembles: rotators.</desc><style>.plate-svg text{font-family:var(--font-mono,'Sometype Mono',ui-monospace,Menlo,monospace)}.plate-svg .edge{fill:none;stroke:var(--canopy,#00a9a0);stroke-width:.45;opacity:.85}.plate-svg .edge.fail{stroke:#ff6b6b;stroke-dasharray:1.4 1.1;opacity:.7}.plate-svg .edge.error{stroke:var(--attention,#ffb454);stroke-width:.3;stroke-dasharray:.4 .8;opacity:.55}.plate-svg .edge.bus{stroke-width:.5;opacity:.85}.plate-svg .edge.order{stroke:currentColor;stroke-width:.3;stroke-dasharray:.5 1.1;stroke-linecap:round;opacity:.9}.plate-svg #plate-arrow path{fill:var(--canopy,#00a9a0);fill-opacity:.85}.plate-svg #plate-arrow-fail path{fill:#ff6b6b;fill-opacity:.7}.plate-svg #plate-arrow-error path{fill:var(--attention,#ffb454);fill-opacity:.7}.plate-svg .node .shape{fill:color-mix(in srgb, var(--nc, var(--canopy, #00a9a0)) 22%, #04110f);stroke:var(--nc, var(--canopy, #00a9a0));stroke-width:.45}.plate-svg .shape-chip .shape{fill:#0c1416;stroke:var(--ink-dim,#9a9890)}.plate-svg .shape-check .shape,.plate-svg .shape-gate .shape{fill:#0c1416;stroke:#e8f6f1}.plate-svg .shape-commit .shape{fill:color-mix(in srgb, var(--canopy, #00a9a0) 35%, #04110f);stroke:var(--canopy,#00a9a0)}.plate-svg .label{font-size:2.3px;fill:#e8f6f1}.plate-svg .harness{font-size:1.9px;fill:var(--nc, var(--canopy, #00a9a0));opacity:.9}.plate-svg .group-box{fill:none;stroke:var(--canopy,#00a9a0);stroke-width:.3;stroke-dasharray:1.2 .9;opacity:.8}.plate-svg .group-title,.plate-svg .group-subtitle{font-size:1.9px;fill:var(--canopy,#00a9a0);letter-spacing:.14em;text-transform:uppercase}.plate-svg .member-shape{fill:color-mix(in srgb, var(--nc, var(--canopy, #00a9a0)) 22%, #04110f);stroke:var(--nc, var(--canopy, #00a9a0));stroke-width:.3}.plate-svg .member-label{font-size:1.9px;fill:#e8f6f1;text-anchor:middle}.plate-svg .mark-error{fill:var(--attention,#ffb454);font-size:2.6px;text-anchor:middle}.plate-svg .mark-fail{fill:none;stroke:#ff6b6b;stroke-width:.5;stroke-dasharray:.6 .5}.plate-svg .done{font-size:2px;fill:var(--canopy,#00a9a0);letter-spacing:.04em}.plate-svg .token{fill:var(--canopy,#00a9a0)}@media (prefers-reduced-motion:reduce){.plate-svg .token{display:none}}.plate-svg .edge-lit{fill:none;stroke:#ff6b6b;stroke-width:.8;stroke-dasharray:1.4 1.1}.plate-svg .unit-lit{fill:var(--canopy,#00a9a0);fill-opacity:.18;stroke:var(--canopy,#00a9a0);stroke-width:.7}@media (prefers-reduced-motion:reduce){.plate-svg .edge-lit{display:none}}@media (prefers-reduced-motion:reduce){.plate-svg .unit-lit{display:none}}</style><defs><marker id="plate-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="1.3" markerHeight="1.3" markerUnits="userSpaceOnUse" orient="auto-start-reverse"><path d="M0 0L10 5L0 10z"/></marker><marker id="plate-arrow-fail" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="1.3" markerHeight="1.3" markerUnits="userSpaceOnUse" orient="auto-start-reverse"><path d="M0 0L10 5L0 10z"/></marker><marker id="plate-arrow-error" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="1.3" markerHeight="1.3" markerUnits="userSpaceOnUse" orient="auto-start-reverse"><path d="M0 0L10 5L0 10z"/></marker></defs><g class="edges"><path class="edge order" d="M40.14 22.5 L40.14 29.5" data-from="rotators" data-to="rotators"/><path class="edge pass" d="M17.14 23.5 L24.03 23.5" marker-end="url(#plate-arrow)" data-from="before" data-to="rotators"/><path class="edge pass" d="M56.25 23.5 L63.14 23.5" marker-end="url(#plate-arrow)" data-from="rotators" data-to="after"/></g><g class="lits"><rect class="unit-lit" x="11.14" y="20.5" width="6" height="6" rx="3" fill="var(--canopy,#00a9a0)" fill-opacity="0.18" stroke="var(--canopy,#00a9a0)" stroke-width="0.7" data-lit data-name="before"><animate att