exports[`plate snapshots > draws spec-loop as a plate 1`] = `"<svg class="plate-svg plate-h" viewBox="0 0 218.56 56.4" width="1093" height="282" role="img" xmlns="http://www.w3.org/2000/svg"><title>spec-loop</title><desc>Nodes in order: start-check, lock-repo, implementer, full-gates, reviewer, commit-check, unlock, human-verdict.</desc><style>.plate-svg text{font-family:var(--font-mono,'Sometype Mono',ui-monospace,Menlo,monospace)}.plate-svg .edge{fill:none;stroke:var(--canopy,#00a9a0);stroke-width:.45;opacity:.85}.plate-svg .edge.fail{stroke:#ff6b6b;stroke-dasharray:1.4 1.1;opacity:.7}.plate-svg .edge.error{stroke:var(--attention,#ffb454);stroke-width:.3;stroke-dasharray:.4 .8;opacity:.55}.plate-svg .edge.bus{stroke-width:.5;opacity:.85}.plate-svg .edge.order{stroke:currentColor;stroke-width:.3;stroke-dasharray:.5 1.1;stroke-linecap:round;opacity:.9}.plate-svg #plate-arrow path{fill:var(--canopy,#00a9a0);fill-opacity:.85}.plate-svg #plate-arrow-fail path{fill:#ff6b6b;fill-opacity:.7}.plate-svg #plate-arrow-error path{fill:var(--attention,#ffb454);fill-opacity:.7}.plate-svg .node .shape{fill:color-mix(in srgb, var(--nc, var(--canopy, #00a9a0)) 22%, #04110f);stroke:var(--nc, var(--canopy, #00a9a0));stroke-width:.45}.plate-svg .shape-chip .shape{fill:#0c1416;stroke:var(--ink-dim,#9a9890)}.plate-svg .shape-check .shape,.plate-svg .shape-gate .shape{fill:#0c1416;stroke:#e8f6f1}.plate-svg .shape-commit .shape{fill:color-mix(in srgb, var(--canopy, #00a9a0) 35%, #04110f);stroke:var(--canopy,#00a9a0)}.plate-svg .label{font-size:2.3px;fill:#e8f6f1}.plate-svg .harness{font-size:1.9px;fill:var(--nc, var(--canopy, #00a9a0));opacity:.9}.plate-svg .group-box{fill:none;stroke:var(--canopy,#00a9a0);stroke-width:.3;stroke-dasharray:1.2 .9;opacity:.8}.plate-svg .group-title,.plate-svg .group-subtitle{font-size:1.9px;fill:var(--canopy,#00a9a0);letter-spacing:.14em;text-transform:uppercase}.plate-svg .member-shape{fill:color-mix(in srgb, var(--nc, var(--canopy, #00a9a0)) 22%, #04110f);stroke:var(--nc, var(--canopy, #00a9a0));stroke-width:.3}.plate-svg .member-label{font-size:1.9px;fill:#e8f6f1;text-anchor:middle}.plate-svg .mark-error{fill:var(--attention,#ffb454);font-size:2.6px;text-anchor:middle}.plate-svg .mark-fail{fill:none;stroke:#ff6b6b;stroke-width:.5;stroke-dasharray:.6 .5}.plate-svg .done{font-size:2px;fill:var(--canopy,#00a9a0);letter-spacing:.04em}.plate-svg .token{fill:var(--canopy,#00a9a0)}@media (prefers-reduced-motion:reduce){.plate-svg .token{display:none}}</style><defs><marker id="plate-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="1.3" markerHeight="1.3" markerUnits="userSpaceOnUse" orient="auto-start-reverse"><path d="M0 0L10 5L0 10z"/></marker><marker id="plate-arrow-fail" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="1.3" markerHeight="1.3" markerUnits="userSpaceOnUse" orient="auto-start-reverse"><path d="M0 0L10 5L0 10z"/></marker><marker id="plate-arrow-error" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="1.3" markerHeight="1.3" markerUnits="userSpaceOnUse" orient="auto-start-reverse"><path d="M0 0L10 5L0 10z"/></marker></defs><g class="edges"><path class="edge pass" d="M147.59 34.85 C158.79 34.85 158.79 34.85 169.99 34.85" marker-end="url(#plate-arrow)" data-from="commit-check" data-to="unlock"/><path class="edge pass" d="M95.59 34.85 C106.69 34.85 106.69 34.85 117.79 34.85" marker-end="url(#plate-arrow)" data-from="full-gates" data-to="reviewer"/><path class="edge pass" d="M69.59 34.85 C80.79 34.85 80.79 34.85 91.99 34.85" marker-end="url(#plate-arrow)" data-from="implementer" data-to="full-gates"/><path class="edge pass" d="M43.59 34.85 C54.69 34.85 54.69 34.85 65.79 34.85" marker-end="url(#plate-arrow)" data-from="lock-repo" data-to="implementer"/><path class="edge pass" d="M121.59 34.85 C132.79 34.85 132.79 34.85 143.99 34.85" marker-end="url(#plate-arrow)" data-from="reviewer" data-to="commit-check"/><path class="edge pass" d="M17.59 34.85 C28.79 34.85 28.79 34.85 39.99 34.85" marker-end="url(