(--canopy, #00a9a0)) 22%, #04110f);stroke:var(--nc, var(--canopy, #00a9a0));stroke-width:.3}.plate-svg .member-label{font-size:1.9px;fill:#e8f6f1;text-anchor:middle}.plate-svg .mark-error{fill:var(--attention,#ffb454);font-size:2.6px;text-anchor:middle}.plate-svg .mark-fail{fill:none;stroke:#ff6b6b;stroke-width:.5;stroke-dasharray:.6 .5}.plate-svg .done{font-size:2px;fill:var(--canopy,#00a9a0);letter-spacing:.04em}.plate-svg .token{fill:var(--canopy,#00a9a0)}@media (prefers-reduced-motion:reduce){.plate-svg .token{display:none}}</style><defs><marker id="horizontal-plate-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="1.3" markerHeight="1.3" markerUnits="userSpaceOnUse" orient="auto-start-reverse"><path d="M0 0L10 5L0 10z"/></marker><marker id="horizontal-plate-arrow-fail" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="1.3" markerHeight="1.3" markerUnits="userSpaceOnUse" orient="auto-start-reverse"><path d="M0 0L10 5L0 10z"/></marker><marker id="horizontal-plate-arrow-error" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="1.3" markerHeight="1.3" markerUnits="userSpaceOnUse" orient="auto-start-reverse"><path d="M0 0L10 5L0 10z"/></marker></defs><g class="edges"><path class="edge pass" d="M147.59 42 C158.79 42 158.79 42 169.99 42" marker-end="url(#horizontal-plate-arrow)" data-from="commit-check" data-to="unlock"/><path class="edge pass" d="M95.59 42 C106.69 42 106.69 42 117.79 42" marker-end="url(#horizontal-plate-arrow)" data-from="full-gates" data-to="reviewer"/><path class="edge pass" d="M69.59 42 C80.79 42 80.79 42 91.99 42" marker-end="url(#horizontal-plate-arrow)" data-from="implementer" data-to="full-gates"/><path class="edge pass" d="M43.59 42 C54.69 42 54.69 42 65.79 42" marker-end="url(#horizontal-plate-arrow)" data-from="lock-repo" data-to="implementer"/><path class="edge pass" d="M121.59 42 C132.79 42 132.79 42 143.99 42" marker-end="url(#horizontal-plate-arrow)" data-from="reviewer" data-to="commit-check"/><path class="edge pass" d="M17.5