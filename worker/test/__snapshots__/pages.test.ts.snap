exports[`route snapshots > renders / with the official listing first 1`] = `
"<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>graphs.univerlab.org · graphs.univerlab.org</title>
<meta name="description" content="A catalogue of Canopy graphs and nodes.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400..800;1,400..800&family=Old+Standard+TT:ital,wght@0,400;0,700;1,400&family=Sometype+Mono:ital,wght@0,400..700;1,400..700&display=swap">
<style>
:root {
  --bg: #f4f0ea;
  --ink: #1d1510;
  --accent: #3fb8b0;
  --display: "Old Standard TT", Georgia, serif;
  --body: "EB Garamond", Georgia, serif;
  --mono: "Sometype Mono", "Courier New", monospace;
}
html[data-theme="night"] {
  --bg: #222928;
  --ink: #ecebe4;
}
* { box-sizing: border-box; }
body {
  margin: 0 auto;
  padding: 1.5rem 1.25rem 3rem;
  max-width: 46rem;
  background: var(--bg);
  color: var(--ink);
  font-family: var(--body);
  font-size: 1.0625rem;
  line-height: 1.55;
}
a { color: var(--accent); }
a:hover, a:focus-visible { text-decoration-thickness: 2px; }
.site-header {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 1rem;
}
.brand {
  font-family: var(--display);
  font-size: 1.5rem;
  color: var(--ink);
  text-decoration: none;
}
.tagline { margin: 0.25rem 0 1.5rem; font-style: italic; }
h1, h2, h3 { font-family: var(--display); line-height: 1.2; }
h1 { font-size: 2rem; margin: 0 0 0.25rem; }
h2 { font-size: 1.35rem; margin: 2rem 0 0.5rem; }
.description { margin: 0 0 1.25rem; font-size: 1.15rem; }
.readme h1 { font-size: 1.6rem; }
.readme h2 { font-size: 1.25rem; }
.readme pre {
  overflow-x: auto;
  padding: 0.75rem;
  border: 1px solid var(--ink);
  border-radius: 4px;
  font-family: var(--mono);
  font-size: 0.85rem;
}
.readme code { font-family: var(--mono); font-size: 0.9em; }
.readme img { max-width: 100%; }
.meta { font-family: var(--mono); font-size: 0.85rem; margin: 0.25rem 0 1rem; }
.tabs { display: flex; gap: 1rem; margin: 1rem 0; font-family: var(--mono); }
.tabs a[aria-current="page"] { color: var(--ink); text-decoration-thickness: 2px; }
.search { display: flex; gap: 0.5rem; align-items: end; margin: 1rem 0 2rem; }
.search label { display: block; font-family: var(--mono); font-size: 0.85rem; }
.search input {
  min-width: 14rem;
  padding: 0.4rem 0.5rem;
  background: var(--bg);
  color: var(--ink);
  border: 1px solid var(--ink);
  border-radius: 4px;
  font-family: var(--body);
  font-size: 1rem;
}
.doc-list { list-style: none; padding: 0; margin: 0; }
.doc-list li { margin: 0.75rem 0; }
.doc-list .doc-name { font-family: var(--display); font-size: 1.15rem; }
.doc-list .doc-description { display: block; }
.button {
  display: inline-block;
  padding: 0.35rem 0.75rem;
  border: 1px solid var(--accent);
  border-radius: 4px;
  color: var(--bg);
  background: var(--accent);
  font-family: var(--mono);
  font-size: 0.9rem;
  text-decoration: none;
  cursor: pointer;
}
.install {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem;
  align-items: center;
  margin: 0.5rem 0 1rem;
}
.install code {
  padding: 0.4rem 0.6rem;
  border: 1px solid var(--ink);
  border-radius: 4px;
  font-family: var(--mono);
  font-size: 0.9rem;
  overflow-x: auto;
}
.copy {
  padding: 0.35rem 0.75rem;
  border: 1px solid var(--ink);
  border-radius: 4px;
  background: var(--bg);
  color: var(--ink);
  font-family: var(--mono);
  font-size: 0.9rem;
  cursor: pointer;
}
.copy:hover, .copy:focus-visible { border-color: var(--accent); }
.theme-toggle {
  padding: 0.2rem 0.6rem;
  border: 1px solid var(--ink);
  border-radius: 4px;
  background: var(--bg);
  color: var(--ink);
  font-family: var(--mono);
  font-size: 0.85rem;
  cursor: pointer;
}
.graph-svg { max-width: 100%; height: auto; margin: 1rem 0; color: var(--ink); }
.graph-svg .node rect { fill: var(--bg); stroke: currentColor; stroke-width: 1.25; }
.graph-svg .node text { font-family: var(--mono); font-size: 12px; fill: currentColor; }
.graph-svg .edge { stroke: currentColor; stroke-width: 1.25; }
.graph-svg .edge.fail { stroke-dasharray: 6 4; }
.agent-nodes { font-family: var(--mono); font-size: 0.95rem; }
.site-footer { margin-top: 3rem; font-family: var(--mono); font-size: 0.85rem; }
.busy { border-left: 3px solid var(--accent); padding-left: 1rem; }
@media (prefers-reduced-motion: reduce) {
  * { transition: none !important; animation: none !important; }
}
</style>
<script>
(function(){var stored=null;try{stored=localStorage.getItem("theme")}catch(e){}var hour=new Date().getHours();var theme=stored||(hour>=6&&hour<18?"day":"night");document.documentElement.dataset.theme=theme;document.addEventListener("DOMContentLoaded",function(){var button=document.getElementById("theme-toggle");if(!button){return}button.addEventListener("click",function(){var next=document.documentElement.dataset.theme==="day"?"night":"day";document.documentElement.dataset.theme=next;try{localStorage.setItem("theme",next)}catch(e){}});});})();
</script>
</head>
<body>
<header class="site-header">
<a class="brand" href="/">graphs.univerlab.org</a>
<button type="button" class="theme-toggle" id="theme-toggle" aria-label="Switch between day and night">Switch between day and night</button>
</header>
<p class="tagline">A catalogue of Canopy graphs and nodes.</p>
<main>
<form class="search" action="/search" method="get"><div><label for="q">Search graphs and nodes</label><input id="q" name="q" type="search" value="" placeholder="hello-graph"></div><button type="submit" class="button">Search</button></form>
<nav class="tabs"><a href="/searchsort=top">Top</a><a href="/searchsort=new">New</a></nav>
<h2>Official</h2>
<h3>Graphs</h3>
<ul class="doc-list"><li><a class="doc-name" href="/g/hello-graph">hello-graph</a> — 7 stars<span class="doc-description">Five nodes with one fail edge, for the drawing test.</span></li></ul>
<h3>Nodes</h3>
<ul class="doc-list"><li><a class="doc-name" href="/n/hello-node">hello-node</a> — 7 stars<span class="doc-description">Example catalogue node: drafts an implementation plan.</span></li></ul>
</main>
<footer class="site-footer"><a href="https://univerlab.org/canopy/">Canopy · UniverLab</a></footer>
<script>
(function(){document.addEventListener("click",function(event){var target=event.target;if(!target||!target.classList||!target.classList.contains("copy")){return}var command=target.getAttribute("data-copy")||"";if(navigator.clipboard){navigator.clipboard.writeText(command)}var original=target.textContent;target.textContent=command;window.setTimeout(function(){target.textContent=original},1500);});})();
</script>
</body>
</html>
"
`;

