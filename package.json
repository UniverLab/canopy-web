{
  "name": "graphs-catalogue",
  "version": "0.1.0",
  "description": "UniverLab graphs catalogue: JSON Schemas and validator for shareable Canopy graph and node documents",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build:look && npm run build:remote-web",
    "build:look": "node scripts/build-look.mjs",
    "build:remote-web": "vite build --config apps/remote/web/vite.config.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && npm run test:worker && npm run test:remote-worker && npm run test:remote-web",
    "test:remote-web": "vitest run --config apps/remote/web/vitest.config.ts",
    "test:worker": "vitest run --config apps/graphs/vitest.config.ts",
    "test:remote-worker": "vitest run --config apps/remote/worker/vitest.config.ts",
    "validate": "tsx src/validate.ts",
    "test:remote-smoke": "playwright test --config apps/remote/web/playwright.config.ts",
    "test:remote-serve": "playwright test --config apps/remote/web/playwright.serve.config.ts",
    "test:graphs-visual": "playwright test --config apps/graphs/playwright.config.ts",
    "test:e2e": "npm run build && npm run test:remote-smoke && npm run test:remote-serve && npm run test:graphs-visual"
  },
  "dependencies": {
    "@cfworker/json-schema": "^4.1.1",
    "@xterm/addon-webgl": "0.18.0",
    "@xterm/xterm": "5.5.0",
    "lucide": "0.577.0",
    "morphicons": "1.7.1"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.12.21",
    "@cloudflare/workers-types": "^5.20261026.1",
    "@eslint/js": "^9.18.0",
    "@playwright/test": "1.64.0",
    "@types/node": "^22.10.0",
    "esbuild": "0.28.2",
    "eslint": "^9.18.0",
    "fake-indexeddb": "6.2.5",
    "happy-dom": "21.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "^3.0.5",
    "wrangler": "^4.153.0"
  }
}
