    "@eslint/js": "^9.18.0",
    "@types/node": "^22.10.0",
    "eslint": "^9.18.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "8.71.2",
    "vitest": "^3.0.5",
    "wrangler": "^4.153.0"
  }
}
