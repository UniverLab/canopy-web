{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": false,
    "declaration": false,
    "sourceMap": false,
    "outDir": "dist",
    "types": ["node", "@cloudflare/vitest-pool-workers"],
    "lib": ["ES2022"]
  },
  "include": [
    "src/**/*.ts",
    "tests/**/*.ts",
    "vitest.config.ts",
    "worker/src/**/*.ts",
    "worker/test/**/*.ts",
    "worker/vitest.config.ts"
  ]
}
